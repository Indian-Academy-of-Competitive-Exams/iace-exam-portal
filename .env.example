# ============================================================================
# IACE Platform — environment template
#
# Copy to `.env` and adjust:   cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets — production values live in
# AWS Secrets Manager / SSM Parameter Store.
# ============================================================================

NODE_ENV=development

# ---- API ----
API_PORT=3000
# Origins allowed to call the API (comma-separated). The two SPAs in local dev.
# REQUIRED in production: the API refuses to boot on an empty list, because an
# empty allowlist reflects whatever origin asks, which is no allowlist at all.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- PostgreSQL ----
# These three feed docker-compose; DATABASE_URL is what Prisma reads.
POSTGRES_USER=iace
POSTGRES_PASSWORD=iace_dev_password
POSTGRES_DB=iace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://iace:iace_dev_password@localhost:5432/iace?schema=public
# A throwaway database `prisma migrate diff` builds the migration history in to
# compare it against schema.prisma (`pnpm db:check`). Never the real one — the
SHADOW_DATABASE_URL=postgresql://iace:iace_dev_password@localhost:5432/iace_shadow?schema=public

# ---- Redis ----
# OTP, sessions, device binding, rate limiting, BullMQ. Never the DB.
# Must run with maxmemory-policy=noeviction wherever it is deployed — the API
# checks at boot and refuses to start production against anything else.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT ----
# Generate real ones with:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_before_any_deploy
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_before_any_deploy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- OTP policy (all state lives in Redis) ----
# Students see an OTP twice: at signup, and to reset a forgotten PIN.
# Admins use email + OTP every login.
OTP_LENGTH=6
OTP_TTL_SEC=300           # code validity — 5 minutes
OTP_RESEND_COOLDOWN_SEC=45
OTP_MAX_VERIFY_ATTEMPTS=5
# console = log the code to the API log (dev). Swap for msg91/email later.
OTP_SENDER=console

# ---- Student PIN policy (counters + setup ticket in Redis; hash in Postgres) ----
# PIN_PEPPER is HMAC'd into the PIN before hashing and is never stored with it.
# Four digits is only 10,000 candidates, so a leaked Student table is only safe
# while this secret is not. Generate with:  openssl rand -base64 48
# Rotating it invalidates every PIN — students recover with an OTP reset.
PIN_PEPPER=dev_only_pin_pepper_change_me_before_any_deploy
PIN_MAX_ATTEMPTS=5        # wrong PINs in a row before the number is locked
# Escalating lockout: each time a number is locked out AGAIN it climbs one rung,
# and the last rung repeats. A flat cooldown can be waited out — at 5 tries per
# 15 min that is ~480 guesses a day against a 10,000-PIN space. The first step
# also serves as the window the wrong-attempt counter lives in.
PIN_LOCKOUT_STEPS_SEC=900,3600,86400   # 15 minutes -> 1 hour -> 1 day
# Quiet time before the ladder drops back to the first rung. Signing in
# correctly or resetting the PIN clears it at once.
PIN_LOCKOUT_DECAY_SEC=86400
PIN_SETUP_TTL_SEC=600     # how long an OTP-verified "set your PIN" ticket lasts

# ---- Rate limits (counted in Redis, so four API containers share one window) ----
# The default counts a SIGNED-IN caller as themselves. The rest count an address, and a coaching
# branch of two hundred students shares one — so these are deliberately generous, and 6B tightens
# them against real numbers. A limit that fires on exam morning is worse than no limit at all.
RATE_LIMIT_DEFAULT_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=120     # OTP request/verify, PIN set, student login, admin OTP, refresh
RATE_LIMIT_SITTING_PER_MIN=60   # autosave and submit, per student
RATE_LIMIT_SHARE_PER_MIN=60     # the public report link, per address

# How many proxies sit in front of the API. 0 trusts nothing, so `req.ip` is the socket address.
# Behind a load balancer this MUST be its hop count, or every caller counts against ONE tracker and
# the first few hundred requests a minute lock out everybody. Never guess it upwards: a trusted
# X-Forwarded-For is a client-supplied identity.
TRUST_PROXY_HOPS=0

# ---- Request body limits ----
# The ordinary API exchanges small JSON, so a generous global limit would only
# widen the surface for cheap memory-pressure attacks. The question importer is
# the one endpoint that legitimately receives a large payload, and gets its own
# limit scoped to /imports.
BODY_LIMIT_DEFAULT=256kb
BODY_LIMIT_IMPORT=10mb
# ---- S3 / object storage (ONE code path — MinIO locally, AWS S3 in prod) ----
# Local (MinIO):   S3_ENDPOINT=http://localhost:9000  + S3_FORCE_PATH_STYLE=true
# Production (S3): leave S3_ENDPOINT empty            + S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=iace-local
S3_ACCESS_KEY_ID=iace_minio_user
S3_SECRET_ACCESS_KEY=iace_minio_password
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/iace-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- MSG91 (student mobile OTP over SMS — DLT registered) ----
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# ---- Email (admin OTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@iace.co.in

# ---- SonarQube (the pre-commit scan; see CLAUDE.md) ----
# Unset either one and the pre-commit scan skips itself with a warning rather
# than blocking. Generate a token in the SonarQube UI: My Account > Security.
SONAR_HOST_URL=http://localhost:9004
SONAR_TOKEN=

# ---- Frontends (Vite reads only VITE_*) ----
VITE_API_URL=http://localhost:3000
