# Expo reads only EXPO_PUBLIC_*, and inlines the value into the bundle at BUILD time. There is no
# runtime switch: a staging app and a production app are two builds of the same source.

# Leave it unset in development: the app calls the API on the machine Metro served it from, port
# 3000, which reaches it from an Android emulator and a phone on the same Wi-Fi.
# Set it to override that, and always for a release build, which refuses plain http and needs https.
# EXPO_PUBLIC_API_URL=https://api.example.com

# No API is deployed yet, so eas.json's preview and production profiles carry no URL and a build
# from either throws on launch naming this variable. Give it to a cloud build as an EAS environment
# variable, or to `eas build --local` from the shell; put it back in eas.json once the hostnames are
# real, so a profile means one environment rather than whatever the shell happened to hold.
