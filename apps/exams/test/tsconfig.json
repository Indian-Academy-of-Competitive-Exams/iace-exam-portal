{
  // Mirrors apps/admin/test: the app tsconfig scopes `include` to src/, and tsx applies a
  // tsconfig only to files it matches, so src/ is listed too. `types` is re-stated because the
  // app itself is browser-scoped — the tests are the only Node code in it.
  //
  // `paths` drops the app's `@iace/contracts` -> source mapping on purpose: tsx honours it,
  // contracts' own package is CommonJS, and a named import off its .ts source then fails at link
  // time. Through node_modules it is the built package, as everywhere else.
  //
  // @iace/ui's and @iace/app-kit's sources are listed as well, and not by choice: a component test
  // renders them, tsx resolves a single tsconfig for the whole run, and a .tsx file it does not
  // match gets esbuild's classic JSX transform — which fails at render with "React is not defined".
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": "..",
    "paths": {}
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../../../packages/ui/src/**/*.ts",
    "../../../packages/ui/src/**/*.tsx",
    "../../../packages/app-kit/src/**/*.ts",
    "../../../packages/app-kit/src/**/*.tsx",
    "../../../packages/app-kit/browser/**/*.ts",
    "../../../packages/app-kit/browser/**/*.tsx"
  ]
}
