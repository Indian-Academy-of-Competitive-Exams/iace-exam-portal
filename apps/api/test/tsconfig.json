{
  // The app's tsconfig scopes `include` to src/, so that `nest build` never
  // emits a test into dist. Tests therefore need their own project — this one —
  // which is what typechecks them AND what tsx reads for `experimentalDecorators`
  // when it transpiles the e2e module's Nest decorators.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // scripts/check-docs.mjs lives above apps/api and is plain JS, so both widen for it.
    "allowJs": true,
    "rootDir": "../../.."
  },
  // src/ is listed as well as test/ on purpose. tsx applies a tsconfig only to
  // files matching its `include`, so without src/ here the services under test
  // are transpiled with the defaults — and NestJS parameter decorators
  // (`@Inject(...)`) fail to parse without `experimentalDecorators`.
  "include": ["**/*.ts", "../src/**/*.ts", "../test-db/**/*.ts"]
}
