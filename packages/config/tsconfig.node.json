{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "IACE node (NestJS)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Node 22 (see .nvmrc / engines) covers ES2024 in full, so `Map.groupBy` and `toSorted` need no downlevelling; the browser packages stay on ES2022.
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "isolatedModules": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "types": ["node"]
  }
}
