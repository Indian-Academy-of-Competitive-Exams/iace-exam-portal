{
  "name": "@iace/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./katex.css": "./src/katex.css",
    "./tailwind.preset": "./tailwind.preset.js",
    "./rich-text": "./src/components/ui/rich-text.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/ui/*.tsx",
    "./test-support/dom": "./test/support/dom.ts"
  },
  "files": [
    "src",
    "tailwind.preset.js",
    "test/support"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf .turbo",
    "test": "TSX_TSCONFIG_PATH=test/tsconfig.json node --import tsx --import ./test/support/dom.ts --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tiptap/extension-mathematics": "3.30.2",
    "@tiptap/extension-subscript": "3.30.2",
    "@tiptap/extension-superscript": "3.30.2",
    "@tiptap/react": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.18.4",
    "lucide-react": "1.31.0",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@iace/config": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
