{
  "name": "@iace/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./tailwind.preset": "./tailwind.preset.js",
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/ui/*.tsx"
  },
  "files": [
    "src",
    "tailwind.preset.js"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf .turbo",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@iace/config": "workspace:*",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
