{
  "name": "@iace/app-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./browser/index.ts"
  },
  "files": [
    "src",
    "browser"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf .turbo",
    "test": "TSX_TSCONFIG_PATH=test/tsconfig.json node --import tsx --import @iace/ui/test-support/dom --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\""
  },
  "dependencies": {
    "@iace/contracts": "workspace:*",
    "@radix-ui/react-popover": "1.1.23"
  },
  "peerDependencies": {
    "@iace/ui": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@iace/config": "workspace:*",
    "@iace/ui": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router-dom": "7.18.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
