{
  "extends": "@iace/config/tsconfig.react.json",
  "compilerOptions": {
    "types": []
  },
  // browser/**/*.tsx is listed explicitly: without it tsc never typechecks the
  // shell, and tsx falls back to the classic JSX transform for those files.
  "include": ["src/**/*.ts", "src/**/*.tsx", "browser/**/*.ts", "browser/**/*.tsx"]
}
