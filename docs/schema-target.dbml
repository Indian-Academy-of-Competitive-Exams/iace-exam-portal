//  ============================================================================
// IACE Platform — CONSOLIDATED TARGET DATA MODEL (DBML)
// ---------------------------------------------------------------------------
// Purpose: the single target data model for V1 — exam taxonomy, series/access,
// question bank, base-config from the exam-pattern workbook, admin permissions,
// central audit, analytics. Paste into https://dbdiagram.io to view the ERD.
//
// HOW TO READ THIS FILE:
//   - Inline comments and Note: strings describe the CURRENT structure only.
// - How the model got here (renames, merges, removed tables) lives in ONE place:
// the CHANGE HISTORY section at the END of the file.
// - Why the model looks this way (settled judgment calls) is in DESIGN DECISIONS,
// also near the end. No open [CONFIRM] items remain.
//
// NOTE: EVERY TABLE here is part of the V1 schema — none is deferred. Only certain
// runtime FEATURES/engines ship later (typing-speed test [blank], the
// SESSION_MODULE_LOCKED module engine, psychometric T-score scoring). Their tables
// / config seams are built now; only the behaviour is phased in.
//
// Conventions:
// PK = text (cuid). Enum members SCREAMING_SNAKE, mirrored in packages/contracts.
// `jsonb` = Prisma Json. `text[]` = Prisma String[] (GIN-indexed where noted).
// M:N shown as EXPLICIT join tables. Where no extra columns are needed these
// may be Prisma implicit M:N instead (noted per table).
// Money = decimal(x,2). Durations in SECONDS (Int) — suffix ...Sec.
//
// GENERATION RULES (applied when this becomes prisma/schema.prisma; not repeated per column):
// EVERY DateTime column is `@db.Timestamptz(3)` (store UTC + tz — server-
// authoritative exam clock; never naive timestamps). Annotate the two most
// critical (Attempt.startedAt/endsAt) so the intent survives the diagram.
// EVERY foreign-key column gets an `@@index` (Postgres does not auto-index FKs).
// PARTIAL (non-unique) index: OutboxEvent poll = `(created_at) WHERE processed_at IS NULL`
//  so relay workers (FOR UPDATE SKIP LOCKED) scan only the pending tail, not all history.
// PARTIAL UNIQUE indexes (raw SQL — Prisma cannot express; write them in the migration):
// * soft-delete reuse: `UNIQUE(mobile) WHERE deleted_at IS NULL` on Student;
// same for Student.externalRef and Branch.name.
// * one graded attempt per test: `UNIQUE(test_id, student_id) WHERE is_graded`.
// * one open unlock request: `UNIQUE(student_id, test_series_id) WHERE status='PENDING'`.
// * one default config per stage: `UNIQUE(exam_stage_id) WHERE is_default` on BaseConfig.
// * flat-config sections: `UNIQUE(base_config_id, order) WHERE module_id IS NULL`.
// NO HARD DELETE of catalog/content rows referenced by history — Question,
// QuestionVersion, Exam, ExamStage, Subject/Topic are ARCHIVE/DEACTIVATE-only.
// QuestionVersion is IMMUTABLE (never UPDATEd). Every historical FK is `ON DELETE RESTRICT`.
// CHECK constraints (raw SQL — Prisma can't express; add in the migration):
// * BaseConfigSection: module_id NOT NULL required when the config's
// timerTemplate = SESSION_MODULE_LOCKED (and NULL otherwise).
// * BaseConfigSection: duration_sec NOT NULL when timerTemplate =
// SECTIONAL_LOCKED; per_question_sec NOT NULL when PER_ITEM_TIMED.
// SECTIONAL-scope tests REQUIRE an explicit section duration — reject the
// test if absent (never invent proportional timing).
// LOCKED-CONFIG IMMUTABILITY: enforce by DB trigger (reject UPDATE of a
// BaseConfig/BaseConfigSection row where locked = true) OR by never mutating —
// both are backed by clone-to-new-version. Don't leave it app-only.
// RETENTION (explicit lifecycle — decide + enforce, don't leave unbounded):
// Attempt/AttemptQuestion = keep (or archive cold after N yrs);
// RowActionLog/ImportLog ~7 yrs (compliance); Notification ~90 days;
// OutboxEvent = prune after processedAt + grace.
// Partition the big append-only tables by time once volume justifies it.
// GIN indexes (tags, enrolledExams[], enrolledFamilies[]) must be FORCED in
// Prisma (`@@index([...], type: Gin)`) and verified with EXPLAIN — importers
// drop the index `type` and a B-tree can't serve array-containment (`@>`).
// Enum arrays are written `text[]` here for dbdiagram; in Prisma they become the
// real enum array (`SupportedLanguage[]`, etc.).
// Reserved words `order` / `type` are used as columns (Prisma quotes them);
// any RAW SQL must quote "order"/"type".
// DENORMALIZED DISPLAY LABELS: do NOT copy mutable names next to FKs (staleness
// + write amplification). Store a label alongside an id ONLY when (a) the value
// is IMMUTABLE (codes: Exam.code, stageKey, programCode — already done), or
// (b) the row is HISTORICAL/snapshot and must show the value AS IT WAS
// (RowActionLog.entityLabel; paper content via QuestionVersion). For everything
// current, keep the FK and join the small cached dimension table — the typed
// client returns {id, name}; "easy referencing" lives in the query layer.
// ACCESS RESOLUTION is ONE canonical predicate (branch enabled AND schedule
// active AND (exam-match OR program-match OR StudentGrant) AND prerequisite
// unlocked AND not test-blocked), computed once and cached in Redis
// (student:{id}:catalog), invalidated on the rare access-moving events. No API
// re-implements a slightly different version.
// NORMALISATION is OUT of V1 — no flag, no storage (revisit via featureFlags later).
//  ============================================================================


//  ============================================================================
// ENUMS
//  ============================================================================

Enum Gender {
  MALE
  FEMALE
  OTHER
}

Enum DifficultyLevel {
  LOW
  MEDIUM
  HIGH
}

Enum SupportedLanguage {  // the languages content can be authored in
  EN
  HI
  TE
}

Enum QuestionType {
  SINGLE_MCQ
  TEXT_FIELD  // typed numeric/text answer (no options), answerKey drives scoring
}

Enum AnswerMode {  // how a TEXT_FIELD answer is matched
  EXACT  // normalized string equality (case/space-insensitive)
  NUMERIC  // parsed both sides, within answerTolerance either way
}

Enum QuestionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

Enum TestUi {  // on-screen interface the engine renders (inherited from config.defaultTestUi)
  CBT  // standard government CBT
  OMR  // CBT engine rendering an OMR bubble-sheet (SI/PC etc.) — a render mode, same paper model
  GENERIC  // lighter test screen
  TYPING  // [NEW / DEFERRED — BLANK] typing-speed skill test; not built in V1 (see placeholder below)
}

Enum NavigationPolicy {  // how the candidate may move through questions
  FREE  // revisit / change / mark-for-review (normal CBT)
  FORWARD_ONLY  // no going back — used by PER_ITEM_TIMED / psychometric
}

Enum LanguageMode {  // per test: how many languages render on screen
  SINGLE  // student picks ONE (optional per-question toggle)
  DUAL  // two render together (stem + options), no toggle
}

Enum TimerTemplate {  // drives the CBT engine — from the workbook Config Legend
  COMPOSITE_FREE  // one clock, free navigation across all sections (SSC CGL T1)
  SECTIONAL_LOCKED  // per-section clock; section locks when its time ends
  SESSION_MODULE_LOCKED  // modules/sessions, each a locked block of sections (e.g. IBPS)
  PER_ITEM_TIMED  // per-question countdown, auto-advance at zero, no revisit (FORWARD_ONLY).
                           // ASSUMPTION — real CBAT batteries often work this way, but the WORKBOOK lists the
                           // psychometric stages as COMPOSITE_FREE / duration n/a. Verify per cycle before use.
}

Enum ExamFamily {  // the 4 exam families — fixed set, no DB table. Add a value in a migration if a new family is ever onboarded.
  SSC
  RRB
  BANKING
  AP_TS_POLICE
}

Enum ExamMode {  // stage delivery mode. Only CBT/OMR are auto-scorable here.
  CBT
  OMR  // rendered via TestUi.OMR (bubble sheet) — SI/PC etc.
  PSYCHOMETRIC  // in the workbook: RRB CBAT (ALP + NTPC Station Master), SBI PO Ph3 component.
                           // Scored by NORM-REFERENCED T-SCORE batteries, min T-score threshold, NO negative
                           // marking — not right/wrong marks. Workbook timer = COMPOSITE_FREE, duration n/a.
  SKILL  // catalog-only in V1 (typing/steno) — see TYPING placeholder
  PHYSICAL  // catalog-only (PET/PST)
  INTERVIEW  // catalog-only
  DESCRIPTIVE  // typed/handwritten — catalog-only in V1
}

Enum MeritType {  // does a stage/section count toward merit or just qualify
  MERIT
  QUALIFYING
}

Enum StageDisposition {  // V1 conductability of a stage (from docs/06 coverage pass)
  CONDUCTED  // pure objective CBT/OMR — full mock, auto-scored
  PARTIAL  // compound stage — conduct the objective section only (descriptive skipped)
  CATALOG_ONLY  // physical / interview / skill / psychometric / LPT / essay — listed, never conducted
}

Enum TestStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

Enum TestScope {  // what the test covers — timing derives from this
  FULL  // the whole config (all sections/modules)
  MODULE  // one session/module of a SESSION_MODULE_LOCKED config
  SECTIONAL  // one section/subject — "subject-level mock"
  TOPIC  // single-topic drill (fast-follow)
}

Enum EvaluationMode {  // does it produce a cohort rank
  RANKED  // live leaderboard + percentile — forces FIXED binding
  PRACTICE  // immediate analytics only, no rank, retakes allowed
}

Enum PaperBinding {  // where the questions come from
  FIXED  // drawn ONCE at finalize, frozen, shared by all (required for RANKED)
  GENERATED  // drawn per attempt from the pool (PRACTICE only)
}

Enum DrawStrategy {  // how the ONE draw engine picks from the pool
  RANDOM  // uniform from the filtered pool
  NEWEST_FIRST  // prefer recently-framed questions (team keeps adding)
  LEAST_SERVED  // spread usage across the bank
  UNSEEN_FIRST  // exclude what this student already saw (generated practice retakes)
}

Enum PaperQuestionStatus {
  ACTIVE
  DROPPED
  BONUS
}

Enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
}

Enum AnswerState {
  NOT_VISITED
  NOT_ANSWERED
  ANSWERED
  MARKED_REVIEW
  ANSWERED_MARKED
}

Enum NotificationType {
  TEST_ASSIGNED
  RESULT_READY
  ENROLLMENT_ADDED
  GRANT_ADDED  // scholarship / direct group grant
  SERIES_UNLOCKED
  GENERIC
}

// -- people / access ---
Enum StudentType {
  ONLINE
  OFFLINE
  NON_IACE
}


Enum BranchType {
  PHYSICAL
  VIRTUAL
}

Enum ImportSource {
  INDIVIDUAL
  SHEET
  SCRIPT
  SELF_SIGNUP
}

// -- series unlock (sequential Tier1 -> Tier2) ---
Enum UnlockMode {  // how a series becomes available to a student
  AUTO  // opens automatically (e.g. on prerequisite completion)
  REQUEST  // student requests -> admin/auto approves
  ADMIN  // admin grants explicitly
}

Enum UnlockState {
  LOCKED
  UNLOCKED
}
Enum UnlockRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// -- admin permissions ---
Enum PermissionLevel {
  READ
  WRITE
}  // WRITE implies mutate + delete

// -- central audit ---
Enum AuditFeature {  // extensible
  STUDENT
  STUDENT_PROFILE
  BRANCH
  ADMIN
  QUESTION
  TEST
  TEST_SERIES
  BASE_CONFIG
  EXAM_TAXONOMY
  TAXONOMY_SUBJECT
  TAXONOMY_TOPIC
  FEATURE_PERMISSION
}
Enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  BLOCK
  UNBLOCK
  IMPORT
}
Enum ActorType {
  ADMIN
  STUDENT
  SCRIPT
  SYSTEM
}


//  ============================================================================
// EXAM TAXONOMY — Family -> Exam -> Stage [NEW LAYER]
// Source of truth: Exam_Pattern_Base_Configurations.xlsx
// (4 families, 43 exams, 122 stages). Existing `ExamType` becomes `Exam`.
//  ============================================================================

Table Exam {  // Exam level: CGL, CHSL, PO, SO...
  id          text [pk]
  family      ExamFamily [not null]  // constant enum (no ExamFamily table)
  code        text [unique, not null]  // "SSC_CGL" — the value stored in Student.enrolledExams[]
  name        text [not null]
  description text
  isActive    boolean [not null, default: true]
  createdAt   timestamp [not null, default: `now()`]
  updatedAt   timestamp [not null]
  indexes { family }
  Note: 'Student.enrolledExams[] references Exam.code (string array/GIN — multi-valued, app-validated). family is a constant enum, not a FK.'
}

Table ExamStage {  // the Stage/Paper level — carries the base config
  id            text [pk]
  examId        text [not null]
  stageKey      text [unique, not null]  // "SSC_CGL_T1" — human-stable, from the workbook
  name          text [not null]  // "Tier 1"
  order         int  [not null, default: 0]
  mode          ExamMode [not null, default: 'CBT']
  disposition   StageDisposition [not null, default: 'CONDUCTED']  // from the coverage pass — drives seeding/UI
  isActive      boolean [not null, default: true]
  createdAt     timestamp [not null, default: `now()`]
  updatedAt     timestamp [not null]
  indexes {
    examId
    (examId, order)
    disposition
  }
  Note: 'TestSeries and BaseConfig attach here. disposition (from docs/06): CONDUCTED = pure objective CBT/OMR (84 stages); PARTIAL = compound, objective section only (6); CATALOG_ONLY = physical/interview/skill/psychometric/LPT/essay, listed not conducted (32). Seeds create BaseConfig only for CONDUCTED + PARTIAL.'
}


//  ============================================================================
// BASE CONFIGS — reusable stage blueprints; a Test copies+snapshots one.
// Locks on first attempt of any test made from it -> clone-to-evolve.
// Extended with the workbook's timer/mode/merit/module fields (normalisation out of V1).
//  ============================================================================

Table BaseConfig {
  id                     text [pk]
  examStageId            text [not null]
  name                   text [not null]  // "SSC CGL Tier 1 — 2025 pattern" (default) or "SSC CGL T1 — Speed Drill" (custom)
  isDefault              boolean [not null, default: false]  // true = the stage's OFFICIAL seeded pattern (one per stage). false = a CUSTOM config an admin created to reuse across their own tests
  clonedFromId           text  // lineage: the config this one was cloned from — powers "start from the default, tweak, save as custom" and clone-to-evolve. NULL for a config authored from scratch or the original seed
  version                int  [not null, default: 1]  // edit counter WITHIN this config's own lineage (clone-to-evolve bumps it) — NOT a stage-wide number
  isActive               boolean [not null, default: true]
  locked                 boolean [not null, default: false]  // true at the FIRST FINALIZE of any test from this config (not just first attempt) — prevents editing shape after a paper is already frozen against it. Read-only once locked; clone to evolve.

  // -- shape ---
  totalQuestions         int [not null]   // display cache (sum of section counts) — avoids summing sections on every test-list render
  totalMarks             decimal(8,2) [not null]   // display cache (sum of section marks)
  durationSec            int [not null]
  timerTemplate          TimerTemplate [not null, default: 'COMPOSITE_FREE']  // section-return behaviour derives from this: COMPOSITE_FREE = may return; SECTIONAL_LOCKED / SESSION_MODULE_LOCKED = no return; PER_ITEM_TIMED = forward-only
  navigation             NavigationPolicy [not null, default: 'FREE']  // FORWARD_ONLY for PER_ITEM_TIMED/psychometric
  optionalSectionCount   int

  // -- render / tooling ---
  defaultTestUi          TestUi [not null, default: 'CBT']
  languageMode           LanguageMode [not null, default: 'SINGLE']
  languages              text[] [not null]  // SupportedLanguage values, ordered; DUAL shows all
  shuffleQuestions       boolean [not null, default: true]
  shuffleOptions         boolean [not null, default: true]
  calculatorEnabled      boolean [not null, default: false]

  // -- workbook feature flags --- (normalisation intentionally omitted — out of V1)
  featureFlags           jsonb  // all boolean feature flags live here
  scoringVersion         int [not null, default: 1]  // which scoring algorithm produced results — bump when neg-marking/normalisation/rounding rules change; lets historical results be reproduced exactly

  createdById            text
  createdAt              timestamp [not null, default: `now()`]
  updatedAt              timestamp [not null]
  indexes {
    examStageId
    (id, examStageId) [unique]  // composite-FK target: Test.(baseConfigId, examStageId) must agree
    clonedFromId               // reverse lineage lookup ("what was cloned from this config")
    isDefault
  }
  Note: 'Source of truth for a Test (inherited, not copied). A stage has ONE default config (isDefault, the seeded official pattern) plus any number of CUSTOM configs admins create to reuse — a Test.baseConfigId may point at either. Once locked (first finalize), clone into a new config version to change; existing tests reference the immutable version. Partial unique (header): one default per stage. scoringVersion tags the algorithm for reproducibility.'
}

Table BaseConfigModule {  // session/module layer above sections (V1 table)
  id            text [pk]  // only used when timerTemplate = SESSION_MODULE_LOCKED
  baseConfigId  text [not null]
  name          text [not null]  // "Objective", "Descriptive"
  order         int  [not null]
  durationSec   int  // module-level lock window
  indexes {
    (baseConfigId, order) [unique]
    (baseConfigId, id) [unique]  // composite-FK target: a section's module must belong to the same BaseConfig
  }
  Note: 'V1 table. Null module = flat config (COMPOSITE_FREE / SECTIONAL_LOCKED). The SESSION_MODULE_LOCKED runtime ENGINE is the deferred FEATURE; the table + config seam ship in V1.'
}

Table BaseConfigSection {
  id                text [pk]
  baseConfigId      text [not null]
  moduleId          text  // nullable -> only set for module-locked configs
  name              text [not null]
  order             int  [not null]
  subjectId         text
  questionCount     int  [not null]
  marksPerQuestion  decimal(6,2) [not null]
  negativeMarks     decimal(6,2) [not null]  // per-section (mixed within a paper allowed)
  durationSec       int
  perQuestionSec    int  // PER_ITEM_TIMED auto-advance window (psychometric)
  mandatory         boolean [not null, default: true]
  meritOrQualifying MeritType [not null, default: 'MERIT']
  qualifyingCutoff  decimal(6,2)  // used when sectionalCutoff / QUALIFYING
  difficultyMix     jsonb
  indexes {
    (baseConfigId, moduleId, order) [unique]  // order is per-MODULE; modules can each restart at 1
    (baseConfigId, id) [unique]  // composite-FK target: a PaperQuestion section must belong to the test's config
    subjectId
    moduleId
  }
  Note: 'Flat configs (moduleId NULL) also need UNIQUE(baseConfigId, order) WHERE module_id IS NULL — see header partial-unique rules (NULLs are distinct, so the composite unique alone would not stop two null-module sections sharing an order). timerTemplate <-> module structure and section-duration requirements are DB CHECK / app invariants (see header).'
}


//  ============================================================================
// QUESTION BANK — Subject -> Topic -> Question -> Version
// IMMUTABLE VERSIONING: Question is stable IDENTITY; each edit creates a new
// QuestionVersion (stem + OPTIONS + answerKey + marks frozen together as one row).
// Papers & attempts reference a questionVersionId -> any past attempt reproduces
// deterministically. Options live INSIDE the version as JSON (one row read = whole
// question, no join on the hot exam path). SubTopic dropped (2-level taxonomy).
//  ============================================================================

Table Subject {
  id    text [pk]
  name  text [unique, not null]
  code  text [unique]
}

Table Topic {
  id        text [pk]
  subjectId text [not null]
  name      text [not null]
  indexes { (subjectId, name) [unique] }
}

Table Question {  // IDENTITY only — taxonomy, type, draw metadata. Content lives in QuestionVersion.
  id                   text [pk]
  questionCode         text [unique]
  type                 QuestionType [not null, default: 'SINGLE_MCQ']
  subjectId            text [not null]
  topicId              text
  difficulty           DifficultyLevel [not null]  // draw filter — stable across versions
  status               QuestionStatus [not null, default: 'DRAFT']
  currentVersionId     text  // pointer to the latest QuestionVersion (what new papers draw)
  tags                 text[]  // GIN. Free-text tags — plain strings, no naming convention. Drives tag-based search + the FIXED draw's pool filter.
  stemHash             text  // canonical dedup hash of the CURRENT version (see notes)
  fixedUseCount        int [not null, default: 0]  // times used in a FIXED paper. UNSEEN_FIRST(fixed)=0; LEAST_SERVED order. Increment ATOMICALLY at finalize.
  createdById          text
  createdAt            timestamp [not null, default: `now()`]
  updatedAt            timestamp [not null]
  indexes {
    (subjectId, difficulty, status)  // auto-draw filter
    topicId
    stemHash
    fixedUseCount
    tags [type: gin]
  }
  Note: 'ARCHIVE-only (never hard delete — history references versions). stemHash canonical: NFC + trim + collapse ws; image = content-token not URL; order-independent option set incl. correct-option text. English content required (app-validated).'
}

Table QuestionVersion {  // immutable snapshot — stem + options + answerKey + marks, one row per edit
  id                   text [pk]
  questionId           text [not null]
  version              int  [not null]  // 1,2,3... per question
  content              jsonb [not null]  // { "<lang>": { stem:[nodes], solution:[nodes] } }
  options              jsonb  // SINGLE_MCQ: [{ id, position, isCorrect, text:{<lang>:[nodes]} }] — stable option ids within the version
  answerKey            jsonb  // TEXT_FIELD: { mode: NUMERIC|TEXT, value(s), tolerance } — language-independent by default
  createdById          text
  createdAt            timestamp [not null, default: `now()`]
  indexes {
    (questionId, version) [unique]
    (questionId, id) [unique]  // composite-FK target: lets Question / PaperQuestion / AttemptQuestion pin a version that provably belongs to the same question
  }
  Note: 'IMMUTABLE ONCE PUBLISHED — editing a DRAFT rewrites its row; any other edit inserts a version and repoints Question.currentVersionId. A version a paper or attempt holds is never rewritten. Options live inside the `options` JSON, so one row is the whole question incl. options with no join on the exam path. AttemptQuestion.selectedOptionId keys into this JSON (app-validated), not a DB FK.'
}


//  ============================================================================
// TESTS — a Test is a MINIMAL configuration: it references an immutable
// BaseConfig version and INHERITS everything (marks, duration, timing,
// structure, shuffle, language, timerTemplate). Nothing about shape is set per
// test. Tests NEVER expire; availability is scheduled per-branch via
// BranchTestConfig. Immutability comes from the config (locks on first attempt,
// evolves by cloning) — so a config reference == the old denormalized snapshot,
// without copying a dozen fields onto every test.
//  ============================================================================

Table Test {
  id             text [pk]
  title          text  // optional — can auto-generate from config + scope + date
  baseConfigId   text [not null]  // the immutable config version this test inherits EVERYTHING from
  examStageId    text [not null]  // denorm (= BaseConfig.examStageId), set at creation — NOT NULL so the (baseConfigId, examStageId) composite FK is always enforced

  scope          TestScope [not null, default: 'FULL']  // FULL | MODULE | SECTIONAL | TOPIC
  scopeRef       jsonb  // MODULE/SECTIONAL/TOPIC: which config module/section(s)/topic(s)
  evaluationMode EvaluationMode [not null, default: 'RANKED']
  paperBinding   PaperBinding [not null, default: 'FIXED']  // validated: RANKED => FIXED
  maxRetakes     int  // null = unlimited (practice); ranked graded attempt is always 1

  // draw source — used by the ONE draw engine (at finalize for FIXED, per attempt for GENERATED)
  questionPoolFilter jsonb  // { tags, subjects, topics, sourceYears, excludeSeen }. tags (e.g. ["ssc cgl mock 05"]) narrow the CANDIDATE pool; the config's per-section counts + timing stay authoritative — the engine fills each section to its count from the filtered pool and flags any shortfall (never silently under/over-fills). Manual pick can complete/override.
  drawStrategy   DrawStrategy [not null, default: 'RANDOM']

  status         TestStatus [not null, default: 'DRAFT']
  isLocked       boolean [not null, default: false]  // FIXED: true once the paper is frozen / first attempt
  version        int [not null, default: 0]  // optimistic lock — finalize/lock via conditional UPDATE ... WHERE version = $n, so the lock-on-first-attempt race resolves to exactly one winner
  finalizedAt    timestamp  // FIXED: when the draw was frozen into PaperQuestion
  createdById    text
  createdAt      timestamp [not null, default: `now()`]
  updatedAt      timestamp [not null]
  indexes {
    baseConfigId
    examStageId
    status
    (id, baseConfigId) [unique]  // composite-FK target: a PaperQuestion's baseConfigId must equal its Test's baseConfigId
  }
  Note: 'A test is NEVER offered on its own — it reaches students ONLY through a TestSeries (see TestSeriesTest). Every Test must belong to >=1 series; creating a lone test auto-creates a singleton series to carry it. No standalone access, no per-test share link (share is at series grain). Minimal by design: marks/duration/timing/structure/shuffle/language/timerTemplate are INHERITED from BaseConfig; timing derives from scope. Validation: RANKED => FIXED; GENERATED => PRACTICE.'
}

// Sections/modules are NOT re-authored per test: structure and timing come from
// BaseConfigModule / BaseConfigSection (the config is immutable once locked). The
// paper references the config section each question was drawn for.

Table PaperQuestion {  // FIXED (ranked) papers ONLY — the frozen shared paper, one set for all
  id            text [pk]
  testId        text [not null]
  baseConfigId  text [not null]  // denorm of Test.baseConfigId — enables composite FK so the section provably belongs to the test's config
  baseConfigSectionId text [not null]  // the CONFIG section this question fills — NOT NULL (TestSectionStat depends on it)
  questionId    text [not null]
  questionVersionId text [not null]  // the frozen version this paper serves (deterministic reproduction)
  order         int  [not null]
  marks         decimal(6,2) [not null]  // copied from the config section at draw
  negativeMarks decimal(6,2) [not null]
  status        PaperQuestionStatus [not null, default: 'ACTIVE']  // post-lock: DROPPED/BONUS
  indexes {
    (testId, questionId) [unique]
    (testId, order) [unique]
    (id, questionId, questionVersionId) [unique]  // composite-FK target: a FIXED AttemptQuestion row pins to this exact (paper, question, version)
    (id, baseConfigSectionId) [unique]  // composite-FK target: a FIXED AttemptQuestion uses the SAME section as its source paper row
    questionId
    questionVersionId
    (baseConfigId, baseConfigSectionId)
  }
  Note: 'FIXED (ranked) papers only — drawn once at finalize, frozen, and shared by all students (fair ranking). Immutability is via questionVersionId: Solution Report and scoring read the pinned QuestionVersion, so later question edits never mutate results. GENERATED practice papers do not live here (the drawn set is carried in AttemptQuestion). Composite FKs guarantee the version belongs to the question and the section to the test config.'
}


// ---------------------------------------------------------------------------
// TYPING-SPEED SKILL TEST [DEFERRED — INTENTIONALLY BLANK]
// Reserved: ExamMode.SKILL + TestUi.TYPING. Not the MCQ/answer-key model —
// it captures a passage + keystrokes and scores WPM / accuracy / backspaces.
// Left unmodelled on purpose; if time permits, a primary version adds e.g.:
// Table TypingTask { id, baseConfigSectionId, passage jsonb, durationSec, language }
// Table TypingResult { attemptId, typedText, wpm, accuracy, errors, backspaces }
// Do NOT build until scoped.
// ---------------------------------------------------------------------------


//  ============================================================================
// ATTEMPTS — live state + scored result in one table (no separate Result).
//  ============================================================================

Table Attempt {
  id               text [pk]
  testId           text [not null]
  studentId        text [not null]
  attemptNo        int  [not null, default: 1]  // 1 = first; >1 = retake
  isGraded         boolean [not null, default: true]  // true ONLY for the single ranked attempt; rollup worker fires only when true. Practice/retakes = false (immediate analytics only)
  status           AttemptStatus [not null, default: 'IN_PROGRESS']

  startedAt        timestamp [not null, default: `now()`]
  endsAt           timestamp [not null]  // server-authoritative deadline
  submittedAt      timestamp
  evaluatedAt      timestamp
  shuffleSeed      int [not null]
  languages        text[] [not null]  // SupportedLanguage values, 1–2 the student chose at start
  sectionState     jsonb  // live per-attempt section state (timers/resume) + this attempt's per-section time. Cohort per-section analytics = TestSectionStat (source of truth), not this JSON.

  // scored (filled by BullMQ worker) — these are the LAST PERSISTED SNAPSHOT; live value always from Redis
  score            decimal(8,2)
  correctCount     int
  wrongCount       int
  unattemptedCount int
  sectionScores    jsonb
  lastRank         int  // snapshot only — do NOT read as authoritative live rank (Redis is)
  lastPercentile   decimal(5,2)

  createdAt        timestamp [not null, default: `now()`]
  updatedAt        timestamp [not null]
  indexes {
    (testId, studentId, attemptNo) [unique]  // retake-ready; V1 UI allows only attemptNo=1
    (studentId, createdAt)  // "my attempts, newest first" (student history)
    (testId, status)
    (testId, score)
  }
}

Table AttemptQuestion {  // one row per per-attempt question item + the student's response
  attemptId         text [not null]
  questionId        text [not null]
  // -- paper item (which question, which version, where) ---
  paperQuestionId   text  // FIXED: links the shared frozen paper (drop/bonus + item analysis). NULL iff GENERATED — this null-ness IS the FIXED/GENERATED marker for the row (enforced by the composite FK below + app)
  questionVersionId text [not null]  // the exact version SERVED — always populated (GENERATED: the drawn version; FIXED: copied from PaperQuestion at write) so a row reproduces deterministically with no join
  baseConfigSectionId text [not null]  // the config section this question fills — every V1-served item maps to one (FULL/SECTIONAL/MODULE scope); required so section analytics never silently drop a question
  order             int [not null]  // this student's display order
  // -- the response ---
  selectedOptionId  text  // option id WITHIN QuestionVersion.options JSON — APP-VALIDATED, deliberately NOT a DB FK (options are JSONB, not a table). null for TEXT_FIELD / unanswered
  typedAnswer       text  // TEXT_FIELD raw input
  state             AnswerState [not null, default: 'NOT_VISITED']
  timeSpentSec      int [not null, default: 0]
  isCorrect         boolean
  marksAwarded      decimal(6,2)
  answeredAt        timestamp
  indexes {
    (attemptId, questionId) [pk]
    questionId  // item analysis + exposure derivation ("questions seen by student")
    paperQuestionId
    (attemptId, order)
  }
  Note: 'The per-attempt-question row: paper item + the student response in one. GENERATED: one row per DRAWN question (paperQuestionId NULL; unanswered rows have null response) — this is the reproducible paper. FIXED: one row per INTERACTED question (paper item read from the shared PaperQuestion via paperQuestionId). SEMANTICS (app + DB enforced): paperQuestionId NULL <=> GENERATED, NOT NULL <=> FIXED; the composite FK to PaperQuestion pins a FIXED row to the frozen paper''s version. WRITE MODEL: in-exam state is authoritative in Redis; the durable row is flushed by a single writer keyed on (attemptId, questionId) as an idempotent UPSERT (last-writer-wins on a monotonic answeredAt/timeSpentSec), so concurrent autosave/retry cannot lose-update — no cross-writer contention. selectedOptionId is app-validated against QuestionVersion.options. Highest-volume table: HASH(attemptId) partitioning is a CANDIDATE, applied only once measured volume justifies it (see retention rules).'
}


//  ============================================================================
// PEOPLE — Student & Admin (separate identity, login, rules)
//  ============================================================================

Table Student {
  id                text [pk]
  mobile            text [unique, not null]  // only mandatory field; editable by ADMIN only
  externalRef       text [unique]  // main-portal id — idempotent SCRIPT re-sync
  studentType       StudentType [not null]  // import-mandatory
  enrolledFamilies  text[] [not null]  // ExamFamily[] (GIN) — enrolled families (SSC/RRB/Banking/Police); multi-enroll. Real ExamFamily enum array in Prisma; text[] here for dbdiagram.
  programs          text[]  // Program.code[] the student is a candidate for (e.g. ["RIP"]) — GIN
  enrolledExams     text[] [not null]  // Exam.code[] (GIN) — exam/exam-type level; multi-exam; validate vs Exam
  // no-groups: ad-hoc access is via the StudentGrant escape-hatch table (not a group membership array)
  currentBranchId   text  // active branch — access/scheduling uses THIS

  // login / profile
  pinHash           text  // 4-digit login PIN (hashed)
  pinIsDefault      boolean [not null, default: true]  // seeded default PIN not yet changed
  fullName          text
  preferredLanguage SupportedLanguage [not null, default: 'EN']  // EN | HI | TE
  preTestReady      boolean [not null, default: false]  // mother+father+dob present
  profileCompleted  boolean [not null, default: false]  // full profile (nudge only)

  // account state — THREE distinct concepts (see notes)
  isActive          boolean [not null, default: true]  // can LOG IN
  isTestBlocked     boolean [not null, default: false]  // admin "deactivate" = locked from attempting
  deletedAt         timestamp  // soft-delete (cannot log in)

  // provenance (lightweight cols; heavy audit -> RowActionLog/ImportLog)
  createdById       text
  createdAt         timestamp [not null, default: `now()`]
  updatedAt         timestamp [not null]
  indexes {
    enrolledFamilies [type: gin]
    enrolledExams    [type: gin]
    currentBranchId
  }
  Note: 'AUTH CHANGE required: login allowed while isActive && deletedAt IS NULL. isTestBlocked only gates attempt-start (today isActive=false wrongly blocks login — decouple). enrolledFamilies = ExamFamily enum values (constant set); enrolledExams reference immutable Exam.code — codes must never be re-used; app-validated. Direct grants -> StudentGrant.'
}

Table StudentProfile {
  id               text [pk]
  studentId        text [unique, not null]
  motherName       text  // pre-test minimal
  fatherName       text  // pre-test minimal
  dob              date  // pre-test minimal
  email            text
  address          text
  gender           Gender
  photoUrl         text  // S3
  // Aadhaar/PAN IMAGES are NOT stored here (India compliance) — they live in the main
  // student-portal DB. Only verification status is mirrored:
  aadhaarVerified  boolean [not null, default: false]
  panVerified      boolean [not null, default: false]
  tenthMarksheetUrl text  // 10th-class marksheet — S3 (non-sensitive doc upload)
  educationDetails jsonb
  pastExamHistory  jsonb
  createdAt        timestamp [not null, default: `now()`]  // parity with other entities
  updatedAt        timestamp [not null]
  Note: 'Any write to motherName/fatherName/dob MUST recompute Student.preTestReady; a full-profile write recomputes Student.profileCompleted (derived flags — keep in sync via the service layer).'
}

Table Admin {
  id           text [pk]
  email        text [unique, not null]
  fullName     text
  isSuperAdmin boolean [not null, default: false]  // bypasses feature checks in app logic
  isActive     boolean [not null, default: true]  // NO soft-delete on Admin (by decision)
  allBranches  boolean [not null, default: false]  // EXPLICIT "all branches" — never inferred from absence of AdminBranch rows
  createdById  text
  createdAt    timestamp [not null, default: `now()`]
  updatedAt    timestamp [not null]
  Note: 'First super admin created by pure SQL (no seed code). Branch scope = AdminBranch rows when allBranches=false; allBranches=true ignores AdminBranch. Enforcement/UI is a later phase.'
}

Table AdminBranch {  // explicit per-admin branch scope (cascades on branch delete)
  adminId  text [not null]
  branchId text [not null]
  indexes {
    (adminId, branchId) [pk]
    branchId
  }
}


//  ============================================================================
// ADMIN PERMISSIONS — code-owned feature catalog, DB stores only grants
//  ============================================================================

Table AdminFeaturePermission {  // one row per (admin, featureKey, level) grant — safe under concurrent grant/revoke, cascades on admin delete
  adminId    text [not null]
  featureKey text [not null]  // mirrors the CODE-OWNED FEATURE_KEYS enum (e.g. "QUESTION_MANAGEMENT"). There is NO Feature table: the catalog (key + display name + group) lives in code and is added in the coding phase; a read-only GET /features serves it to the assign-permissions UI. featureKey is app-validated against the enum (unknown key rejected). Optionally a Postgres enum FeatureKey for DB-level validity (enum migration per feature) — start as text.
  level      PermissionLevel [not null]  // READ | WRITE(=mutate+delete)
  indexes {
    (adminId, featureKey, level) [pk]
    featureKey
  }
  Note: 'One row per (admin, featureKey, level) grant; super admins bypass checks entirely. Feature keys are CODE (FEATURE_KEYS enum), never registered from the UI — the super admin assigns permissions only. No Feature table.'
}


//  ============================================================================
// BRANCHES / SERIES / ACCESS  (no-groups model)
// A student reaches a TestSeries through a derived access path — exam match
// (TestSeries.examStageId's exam ∈ student.enrolledExams), program match
// (TestSeries.programCode ∈ student.programs), or an explicit StudentGrant — and the
// series must be enabled for the student's branch via BranchTestConfig. No open-to-all.
//
// STUDENT vs ADMIN VIEW:
// - Branch is an ADMIN-ONLY abstraction for enabling/scheduling series per cohort.
// It is never shown to students.
// - The student-facing catalog is a flat list of the TESTSERIES they can access
// (resolved behind the scenes). A student sees "series -> tests".
//  ============================================================================

Table Branch {
  id        text [pk]
  name      text [unique, not null]  // UPPERCASE, single-spaced
  type      BranchType [not null]  // PHYSICAL | VIRTUAL (all online share one VIRTUAL branch)
  isActive  boolean [not null, default: true]  // inactive = write-freeze (no new tags); existing retained
  deletedAt timestamp
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  Note: 'All online students share one VIRTUAL branch. Access/scheduling is per (branch, series) via BranchTestConfig.'
}


Table TestSeries {  // THE unit of offering — every test reaches students only through a series
  id                   text [pk]
  name                 text [not null]
  description          text
  examStageId          text  // stage-level product (e.g. SSC CGL T1 series)
  programCode          text  // NULL = general (exam/family access); set = program-only (needs programCode IN student.programs)
  sequentialTests      boolean [not null, default: false]  // intra-series: unlock tests in TestSeriesTest.order (test N+1 after N). OFF by default = all tests available together
  prerequisiteSeriesId text  // cross-series unlock (T2 series requires T1 series) — nullable
  unlockMode           UnlockMode [not null, default: 'AUTO']
  isFree               boolean [not null, default: false]  // PRICING flag ONLY — free = no payment, NOT open access
  createdAt            timestamp [not null, default: `now()`]
  updatedAt            timestamp [not null]
  indexes {
    examStageId
    prerequisiteSeriesId  // reverse: "which series require this one"
  }
  Note: 'The unit of offering. Access ALWAYS requires branch config plus a matching access path (exam/program derived, or a StudentGrant), even when isFree (free = pricing, not open). A lone test is carried by its own single-test series. programCode NULL = general access; set = program-only.'
}

Table StudentSeriesUnlock {  // per-student unlock state for sequential series
  id           text [pk]
  studentId    text [not null]
  testSeriesId text [not null]
  unlockedAt   timestamp
  createdAt    timestamp [not null, default: `now()`]
  indexes {
    (studentId, testSeriesId) [unique]
    testSeriesId  // reverse: "who has unlocked series X"
  }
}

Table SeriesUnlockRequest {  // the "request access to next tier" layer (V1 table)
  id           text [pk]
  studentId    text [not null]
  testSeriesId text [not null]
  status       UnlockRequestStatus [not null, default: 'PENDING']
  requestedAt  timestamp [not null, default: `now()`]
  decidedAt    timestamp
  decidedById  text
  indexes {
    (studentId, testSeriesId, status)
    (testSeriesId, status)  // admin approval queue: pending requests for series X
  }
}

Table BranchTestConfig {  // access-enable + default schedule, per (branch, series)
  id           text [pk]
  branchId     text [not null]
  testSeriesId text [not null]
  enabled      boolean [not null, default: true]  // this branch's students get this series
  startAt      timestamp  // default availability window (series-level)
  endAt        timestamp
  createdAt    timestamp [not null, default: `now()`]
  updatedAt    timestamp [not null]
  indexes {
    (branchId, testSeriesId) [unique]
    testSeriesId  // reverse: "which branches schedule series X"
  }
  Note: 'Access granted at series level. Per-test window override is a FUTURE additive seam (BranchTestSchedule) — no access change.'
}


//  ============================================================================
// M:N JOIN TABLES (explicit for clarity; may be Prisma-implicit where no cols)
//  ============================================================================




// QUESTION EXPOSURE ("questions a student has seen") is DERIVED, not stored: DISTINCT
// questionId in AttemptQuestion for the student (fixed + generated) UNION the questions of
// the fixed papers they attempted. Hot UNSEEN_FIRST membership uses a Redis set built from
// that; Question.fixedUseCount serves UNSEEN_FIRST(fixed) = never-used-in-any-test.

Table Program {  // special coaching-variant catalog — a NEW program is one INSERT (no migration)
  id        text [pk]
  code      text [unique, not null]  // "RIP" — referenced by Student.programs[] and TestSeries.programCode
  name      text [not null]
  isActive  boolean [not null, default: true]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

Table StudentGrant {  // direct series grant — scholarship / manual / one-off event cohort
  studentId    text [not null]
  testSeriesId text [not null]
  createdAt    timestamp [not null, default: `now()`]
  createdById  text
  indexes {
    (studentId, testSeriesId) [pk]
    testSeriesId
  }
  Note: 'The escape hatch for access that is NOT exam/program/branch derivable (scholarship, ad-hoc events, manual adds).'
}

Table TestSeriesTest {  // TestSeries <-> Test — MANDATORY membership: every Test in >=1 series (no standalone)
  testSeriesId text [not null]
  testId       text [not null]
  order        int  // position within the series (drives sequentialTests unlock)
  createdAt    timestamp [not null, default: `now()`]
  createdById  text
  indexes {
    (testSeriesId, testId) [pk]
    testId  // "which series is this test in" — the offering lookup
  }
  Note: 'A test can be in several series, but must be in at least one (app-enforced — no orphan tests, no standalone offering).'
}


//  ============================================================================
// CENTRAL AUDIT (two tables — imports + row-level actions). Always-on.
// Scope = data CRUD + imports only. NEVER exam interactions (those = AttemptQuestion).
//  ============================================================================

Table ImportLog {
  id         text [pk]
  feature    AuditFeature [not null]
  source     ImportSource [not null]
  actorId    text  // admin id (or null for SCRIPT/SELF_SIGNUP)
  fileS3Key  text  // uploaded sheet OR snapshot of SCRIPT-sync payload
  total      int [not null, default: 0]
  created    int [not null, default: 0]
  updated    int [not null, default: 0]
  skipped    int [not null, default: 0]
  failed     int [not null, default: 0]
  status     text [not null]  // RUNNING | DONE | FAILED
  errors     jsonb
  startedAt  timestamp [not null, default: `now()`]
  finishedAt timestamp
  indexes { (feature, startedAt) }
  Note: 'EVERY import file is stored in S3 (fileS3Key) for audit.'
}

Table RowActionLog {
  id          text [pk]
  feature     AuditFeature [not null]
  entityId    text [not null]
  entityLabel text  // human label AS IT WAS (survives rename/delete) — audit readability without a join
  action      AuditAction [not null]
  actorType   ActorType [not null]
  actorId     text
  changed     jsonb  // { field: { from, to } } — the "what changed" diff
  importLogId text  // set when the row came from an import
  createdAt   timestamp [not null, default: `now()`]
  indexes {
    (feature, entityId, createdAt)  // entity history
    (actorId, createdAt)  // "normal admin sees own actions"
    createdAt  // retention pruning
    importLogId  // rows from a given import
  }
  Note: 'changed jsonb: WHITELISTED fields only, capped payload size, secrets/PII redacted (student/profile data flows here). Retention policy applies (partition by time at volume). Super admin sees all; normal admin sees own actions.'
}


//  ============================================================================
// DURABILITY — outbox + rollup idempotency
// Redis accelerates aggregation but is NEVER the only copy of a business event.
//  ============================================================================

Table OutboxEvent {  // durable event log — written in the SAME txn as the state change
  id            text [pk]
  aggregateType text [not null]  // "Attempt" | "Test" | "TestSeries" | ...
  aggregateId   text [not null]
  eventType     text [not null]  // ATTEMPT_SUBMITTED | ATTEMPT_EVALUATED | TEST_FINALIZED | SERIES_UNLOCKED | STUDENT_ENROLLED | ...
  payload       jsonb
  createdAt     timestamp [not null, default: `now()`]
  processedAt   timestamp  // NULL = pending; a relay drains -> Redis/analytics/notifications
  indexes {
    (processedAt, createdAt)  // poll pending oldest-first; back this with a PARTIAL index WHERE processed_at IS NULL (header) so the poll scans only the pending tail
    (aggregateType, aggregateId, createdAt)
  }
  Note: 'Transactional outbox: state change + event insert commit together, so "DB updated but Redis update failed" never loses data — the event stays here until relayed. RELAY CONCURRENCY: multiple relay workers poll with SELECT ... WHERE processed_at IS NULL ORDER BY created_at FOR UPDATE SKIP LOCKED, so each event is claimed by exactly one worker with no double-drain; downstream is idempotent anyway (ProcessedRollup), so at-least-once redelivery is safe. Feeds the Redis leaderboard, analytics rollups, and notifications.'
}

Table ProcessedRollup {  // exactly-once guard for analytics rollups
  attemptId  text [not null]
  rollupType text [not null]  // COHORT | STUDENT | SECTION | QUESTION
  processedAt timestamp [not null, default: `now()`]
  indexes { (attemptId, rollupType) [pk] }
  Note: 'A retried/redelivered evaluation checks-or-inserts here first; UNIQUE(attemptId, rollupType) makes each attempt count exactly once per rollup, even across worker retries. Replaces the timestamp-only evaluatedAt guard.'
}


//  ============================================================================
// NOTIFICATIONS (in-app now; mobile push later via outbound-sender seam)
//  ============================================================================

Table Notification {
  id        text [pk]
  studentId text [not null]
  type      NotificationType [not null]
  title     text [not null]
  body      text
  testId       text  // deep-link for TEST_ASSIGNED / RESULT_READY
  testSeriesId text  // deep-link for SERIES_UNLOCKED / ENROLLMENT / GRANT (series/group-scoped types)
  isRead    boolean [not null, default: false]
  createdAt timestamp [not null, default: `now()`]
  indexes {
    (studentId, createdAt)  // feed: newest-first (dominant query)
    (studentId, isRead)  // unread badge count
    testId
    testSeriesId
  }
}


//  ============================================================================
// ANALYTICS ROLLUPS
// Pre-aggregated so the student dashboard (post-login landing) and the admin
// test report are O(1) reads — they NEVER scan Attempt / AttemptQuestion.
//
// MAINTENANCE MODEL (the point of these tables):
// Store SUMS + COUNTS, not averages. Every update is an idempotent DELTA
// (avg/accuracy/pValue derived on read), never a re-scan of base data.
// [B2 fix] TWO WRITE PATHS by contention, NOT one synchronous path:
// * COHORT rollups (TestStat, TestSectionStat, TestQuestionStat) are a SHARED
// hot row per test — NEVER upsert them synchronously per submit (thousands of
// submits would serialize on one row lock inside the scoring txn). Instead the
// scoring worker increments counters in REDIS (where the leaderboard already
// lives), and a DEBOUNCED / end-of-window BATCH flush materializes them into
// Postgres. Keeps Postgres off the hot path — the whole point of the queue.
// * PER-STUDENT rollups (StudentStat, StudentSubjectStat) touch only that one
// student's own row (no cross-student contention) -> may be applied inline in
// the scoring txn, guarded exactly-once by the evaluatedAt one-shot guard.
// TWO TIERS by Attempt.isGraded:
// * isGraded=true (the one ranked attempt) -> cohort (Redis->batch) + the
// student's StudentStat headline + the StudentSubjectStat bucket for its type.
// * isGraded=false (practice / retakes) -> ONLY the StudentSubjectStat bucket
// + StudentStat.practiceAttempts++. Never cohort, never percentile. (Every
// attempt is still scored for its own immediate analytics.)
// StudentSubjectStat is bucketed by (scope, evaluationMode) so the strength
// map is filterable by test type; "overall" sums the buckets on read.
// Non-incremental metrics (median, exact percentile, discrimination index)
// are refreshed by the same BATCH job from the histogram/counters AFTER the
// spike settles — not on the read path, not per attempt.
// DROP/BONUS correction on a locked paper triggers a TARGETED rebuild of that
// one test's rollups (+ the affected students' deltas), guarded by the
// `attemptsIncluded` / `computedThrough` watermarks below.
// Live in-exam rank/percentile is still Redis; these are the DURABLE
// post-hoc aggregates that outlive Redis eviction and power reports.
// Per-STUDENT trend over time is intentionally NOT a table — it derives
// cheaply from Attempt rows (indexed by studentId). What is expensive, and
// therefore rolled up, is cross-attempt subject/topic accuracy and
// cross-attempt item analysis (both require joining AttemptQuestion→questions).
//  ============================================================================

Table StudentStat {  // 1:1 Student — lifetime aggregate (dashboard header)
  studentId        text [pk]
  testsAttempted   int [not null, default: 0]
  testsEvaluated   int [not null, default: 0]
  sumScore         decimal(16,2) [not null, default: 0]  // avgScore = sumScore / testsEvaluated
  sumPercentile    decimal(16,2) [not null, default: 0]  // avgPercentile = sumPercentile / testsEvaluated
  bestPercentile   decimal(5,2)
  totalAnswered    int [not null, default: 0]  // questions the student actually attempted
  totalCorrect     int [not null, default: 0]
  totalWrong       int [not null, default: 0]
  totalUnattempted int [not null, default: 0]
  sumTimeSec       bigint [not null, default: 0]  // avgTime/Q = sumTimeSec / totalAnswered
  practiceAttempts int [not null, default: 0]  // practice sessions (unranked) — headline count only
  lastAttemptAt    timestamp
  computedThrough  timestamp  // watermark for drift/rebuild
  computedAt       timestamp [not null]
  Note: 'Ranked headline: percentile/rank fields fold in GRADED attempts only. practiceAttempts is a count; practice detail lives in StudentSubjectStat.'
}

Table StudentSubjectStat {  // per (student, subject, TEST-TYPE) — filterable strength / weakness
  studentId      text [not null]
  subjectId      text [not null]
  scope          TestScope [not null]  // FULL | SECTIONAL | ... — filter "full-length vs sectional"
  evaluationMode EvaluationMode [not null]  // RANKED | PRACTICE — filter "practice vs ranked"
  attempted    int [not null, default: 0]
  correct      int [not null, default: 0]
  wrong        int [not null, default: 0]
  sumTimeSec   bigint [not null, default: 0]
  computedAt   timestamp [not null]
  indexes {
    (studentId, subjectId, scope, evaluationMode) [pk]
  }
  Note: 'Bucketed by test type so the strength map filters by kind (full-length / sectional / practice / ranked); "overall" = sum across buckets (few rows/subject). PRACTICE attempts DO feed this (personal skill), even though they never feed cohort/percentile rollups. StudentTopicStat is the same shape at topic grain — fast-follow.'
}

Table TestStat {  // 1:1 Test — cohort aggregate + score distribution
  testId            text [pk]
  attemptCount      int [not null, default: 0]  // started
  evaluatedCount    int [not null, default: 0]  // scored (the denominator for averages)
  sumScore          decimal(18,2) [not null, default: 0]  // avgScore = sumScore / evaluatedCount
  maxScore          decimal(8,2)
  minScore          decimal(8,2)
  sumTimeSec        bigint [not null, default: 0]
  scoreHistogram    jsonb  // { bucket: count } — percentile/median without scanning
  topperAttemptId   text
  attemptsIncluded  int [not null, default: 0]  // watermark: rows folded in (rebuild guard)
  computedAt        timestamp [not null]
  Note: 'Durable distribution for reports; live percentile during the exam stays in Redis. median / exact percentile computed by BATCH from scoreHistogram, never per read.'
}

Table TestSectionStat {  // per (test, config section) — FIXED/ranked tests only
  testId              text [not null]
  baseConfigSectionId text [not null]  // the config section
  attempted           int [not null, default: 0]
  sumScore            decimal(18,2) [not null, default: 0]
  sumTimeSec          bigint [not null, default: 0]
  computedAt          timestamp [not null]
  indexes { (testId, baseConfigSectionId) [pk] }
}

Table TestQuestionStat {  // per (test, paper question) — item analysis + distractor. FIXED papers only (GENERATED rolls up per-question globally).
  testId          text [not null]
  paperQuestionId text [not null]
  questionId      text [not null]  // lineage — roll up to global QuestionStat later
  attemptedCount  int [not null, default: 0]
  correctCount    int [not null, default: 0]
  wrongCount      int [not null, default: 0]
  skippedCount    int [not null, default: 0]  // visited but not answered
  sumTimeSec      bigint [not null, default: 0]
  optionCounts    jsonb  // { optionId: chosenCount } — distractor analysis
  pValue          decimal(5,4)  // difficulty index = correct/attempted (batch)
  discrimination  decimal(6,4)  // top-vs-bottom group (BATCH only — non-incremental)
  computedAt      timestamp [not null]
  indexes {
    (testId, paperQuestionId) [pk]
    questionId
  }
}


//  ============================================================================
// RELATIONSHIPS
//  ============================================================================

// taxonomy
Ref: ExamStage.examId         > Exam.id

// base config
Ref: BaseConfig.examStageId          > ExamStage.id
Ref: BaseConfig.clonedFromId         > BaseConfig.id   // self-lineage (clone-from); nullable
Ref: BaseConfigModule.baseConfigId   > BaseConfig.id
Ref: BaseConfigSection.baseConfigId  > BaseConfig.id
Ref: BaseConfigSection.(baseConfigId, moduleId) > BaseConfigModule.(baseConfigId, id)  // the section's module must belong to the SAME config (MATCH SIMPLE skips for flat sections where moduleId is null)
Ref: BaseConfigSection.subjectId     > Subject.id

// question bank
Ref: Topic.subjectId              > Subject.id
Ref: Question.subjectId           > Subject.id
Ref: Question.topicId             > Topic.id
Ref: Question.(id, currentVersionId) > QuestionVersion.(questionId, id)   // currentVersionId must be a version OF THIS question (nullable pre-first-version; MATCH SIMPLE skips when null)
Ref: QuestionVersion.questionId   > Question.id

// tests — composite FKs guarantee Test/config/section/version consistency
Ref: Test.examStageId         > ExamStage.id
Ref: Test.(baseConfigId, examStageId) > BaseConfig.(id, examStageId)  // test's config must be of the same stage
Ref: PaperQuestion.(testId, baseConfigId) > Test.(id, baseConfigId)  // the paper's baseConfigId must equal its Test's baseConfigId
Ref: PaperQuestion.(baseConfigId, baseConfigSectionId) > BaseConfigSection.(baseConfigId, id)  // section belongs to the config
Ref: PaperQuestion.questionId > Question.id
Ref: PaperQuestion.(questionId, questionVersionId) > QuestionVersion.(questionId, id)  // version belongs to the question

// attempts — AttemptQuestion holds the per-attempt-question item + response
Ref: Attempt.testId             > Test.id
Ref: Attempt.studentId          > Student.id
Ref: AttemptQuestion.attemptId          > Attempt.id
Ref: AttemptQuestion.questionId         > Question.id
Ref: AttemptQuestion.(questionId, questionVersionId) > QuestionVersion.(questionId, id)  // version always belongs to the question (questionVersionId is NOT NULL, so always enforced)
Ref: AttemptQuestion.(paperQuestionId, questionId, questionVersionId) > PaperQuestion.(id, questionId, questionVersionId)  // FIXED rows: pin to the frozen paper's exact version (MATCH SIMPLE skips for GENERATED where paperQuestionId is null)
Ref: AttemptQuestion.(paperQuestionId, baseConfigSectionId) > PaperQuestion.(id, baseConfigSectionId)  // FIXED rows: use the SAME section as the source paper row (MATCH SIMPLE skips for GENERATED)
Ref: AttemptQuestion.baseConfigSectionId > BaseConfigSection.id

// people
Ref: StudentProfile.studentId  - Student.id
Ref: Student.currentBranchId   > Branch.id
Ref: ProcessedRollup.attemptId > Attempt.id

// permissions
Ref: AdminFeaturePermission.adminId   > Admin.id
Ref: AdminBranch.adminId  > Admin.id
Ref: AdminBranch.branchId > Branch.id

// series / access
Ref: TestSeries.examStageId          > ExamStage.id
Ref: TestSeries.prerequisiteSeriesId > TestSeries.id
Ref: StudentSeriesUnlock.studentId    > Student.id
Ref: StudentSeriesUnlock.testSeriesId > TestSeries.id
Ref: SeriesUnlockRequest.studentId    > Student.id
Ref: SeriesUnlockRequest.testSeriesId > TestSeries.id
Ref: BranchTestConfig.branchId     > Branch.id
Ref: BranchTestConfig.testSeriesId > TestSeries.id
Ref: TestSeries.programCode        > Program.code
Ref: StudentGrant.studentId        > Student.id
Ref: StudentGrant.testSeriesId     > TestSeries.id


// joins
Ref: TestSeriesTest.testSeriesId > TestSeries.id
Ref: TestSeriesTest.testId       > Test.id

// audit / notifications
Ref: RowActionLog.importLogId  > ImportLog.id
Ref: Notification.studentId    > Student.id
Ref: Notification.testId       > Test.id
Ref: Notification.testSeriesId > TestSeries.id

// analytics rollups (1:1 / derived — FK to the base rows they summarise)
Ref: StudentStat.studentId          - Student.id
Ref: StudentSubjectStat.studentId   > Student.id
Ref: StudentSubjectStat.subjectId   > Subject.id
Ref: TestStat.testId                - Test.id
Ref: TestStat.topperAttemptId       > Attempt.id
Ref: TestSectionStat.testId              > Test.id
Ref: TestSectionStat.baseConfigSectionId > BaseConfigSection.id
Ref: TestQuestionStat.testId          > Test.id
Ref: TestQuestionStat.paperQuestionId > PaperQuestion.id
Ref: TestQuestionStat.questionId      > Question.id


//  ============================================================================
// DESIGN DECISIONS — the former open points, now settled.
// ----------------------------------------------------------------------------
// These describe why the CURRENT model looks the way it does. No open [CONFIRM]
// items remain; see CHANGE HISTORY at the end for the full evolution.
//
// 1. BaseConfig.totalQuestions / totalMarks are KEPT as a display cache (sum of the
//    section counts/marks), so test-list and header renders never sum sections. The
//    service layer recomputes them whenever sections change (config is locked after
//    first finalize, so they cannot drift for a live config).
// 2. lockedSectionSwitching is DROPPED. Workbook check (Exam Hierarchy "Section
//    Switching Allowed") confirmed section-return is fully determined by timerTemplate
//    for every V1-conducted, multi-section exam: COMPOSITE_FREE = may return;
//    SECTIONAL_LOCKED / SESSION_MODULE_LOCKED = no return; PER_ITEM_TIMED = forward-only.
//    The only workbook exceptions are the two psychometric CBAT stages (CATALOG_ONLY,
//    not conducted) and IBPS_SO_MAIN_PK (a single-section paper — nothing to switch to).
// 3. SESSION_MODULE_LOCKED: the module *engine* is DEFERRED from V1 (V1 runs
//    COMPOSITE_FREE + SECTIONAL_LOCKED); the BaseConfigModule table + config seam still
//    ship now, so enabling the engine later is a code change, not a migration.
// 4. OMR is RENDER-ONLY in V1 — the bubble-sheet UI is a display mode over the same
//    paper/scoring model; OMR never changes scoring.
// 5. Psychometric (RRB_NTPC_CBAT, RRB_ALP_CBAT, SBI_PO_PH3 component) is CATALOG_ONLY
//    in V1. Its distinguishing trait is SCORING — T-score batteries, min-threshold, no
//    negative marking — which needs a battery/T-score result shape not modelled here.
//    That shape is added only when these stages are scheduled to run.
//  ============================================================================


//  ============================================================================
// CHANGE HISTORY — how this model evolved from the Phase-0 schema.
// Reference only; the tables above already reflect all of this. Kept separate so
// the inline comments can describe the CURRENT structure without carrying diffs.
// ----------------------------------------------------------------------------
// EXAM FAMILY -> CONSTANT
// - Dropped the ExamFamily table; ExamFamily is now a constant enum
// (SSC/RRB/BANKING/AP_TS_POLICE). Exam.family is an enum column (was a familyId
// FK); Student.enrolledFamilies is an ExamFamily[] enum array.
//
// ACCESS: GROUPS -> DERIVED (no-groups variant)
// - Removed Group / StudentGroupGrant / GroupTestSeries / GroupBranch. Access is
// now derived: exam-match (enrolledExams) ∪ program-match (Program catalog +
// Student.programs[] + TestSeries.programCode) ∪ explicit StudentGrant, gated by
// BranchTestConfig (explicit per-branch enable/schedule rows).
// - Admin.branchIds[] -> AdminBranch join + explicit allBranches flag.
// - FeaturePermission.adminIds[] array -> AdminFeaturePermission join (one row per
// grant), keyed on code-owned featureKey. Feature/Page tables dropped entirely — the
// feature catalog is code (FEATURE_KEYS), never UI-registered. Branch.isGlobal dropped.
//
// QUESTION BANK: IMMUTABLE VERSIONING
// - Question is identity only; QuestionVersion holds immutable content + options +
// answerKey. Separate QuestionOption table folded into QuestionVersion.options
// JSON. SubTopic dropped (2-level taxonomy). Papers/attempts pin a
// questionVersionId for deterministic reproduction; PaperQuestion JSON snapshots
// and Attempt.drawnQuestions removed. answerMode/answerTolerance columns removed
// (answerKey jsonb is the sole source).
//
// TESTS & ATTEMPTS
// - Test is minimal: inherits marks/duration/timing/structure from an immutable
// BaseConfig version; TestModule/TestSection removed. ONE draw engine (FIXED at
// finalize / GENERATED per attempt). Test.version = optimistic lock for the
// lock-on-first-attempt race. BaseConfig.locked trips at first FINALIZE.
// - CONFIGS: per-test overrides of marks/timing were rejected (they'd undo the minimal
// Test). Instead a stage has one DEFAULT config (isDefault, seeded) + any number of
// CUSTOM configs (isDefault=false, clonedFromId lineage) admins create and reuse; a
// Test points at either. Dropped BaseConfig UNIQUE(examStageId, version) (many configs
// per stage now); version is per-lineage; partial UNIQUE(examStageId) WHERE is_default.
// - The former per-question AttemptQuestion + per-answer AttemptAnswer tables merged into
// one AttemptQuestion row (one per question in the attempt, response as columns). StudentQuestion-
// Exposure removed (exposure derived from AttemptQuestion). Attempt.rank/percentile
// -> lastRank/lastPercentile snapshots (live value is Redis).
//
// INTEGRITY, DURABILITY, ANALYTICS
// - Composite FKs enforce cross-entity consistency at the DB:
//   * Test.(baseConfigId,examStageId)->BaseConfig — test's config is of the test's stage
//     (examStageId is NOT NULL so this is always enforced).
//   * BaseConfigSection.(baseConfigId,moduleId)->BaseConfigModule — a section's module is
//     in the SAME config.
//   * PaperQuestion.(testId,baseConfigId)->Test — the paper's config equals its test's config.
//   * PaperQuestion section->config and version->question.
//   * Question.(id,currentVersionId)->QuestionVersion — currentVersion is OF this question.
//   * AttemptQuestion.(paperQuestionId,questionId,questionVersionId)->PaperQuestion — a FIXED
//     row pins to the frozen paper's version; and (paperQuestionId,baseConfigSectionId)->
//     PaperQuestion — a FIXED row uses the paper's section.
//   BaseConfig UNIQUE(examStageId, version). scoringVersion tags the algorithm per result.
// - AttemptQuestion.questionVersionId is NOT NULL and always populated (FIXED copies it
// from PaperQuestion), so every row reproduces deterministically; order + baseConfigSectionId
// are NOT NULL. paperQuestionId null-ness is the FIXED/GENERATED marker.
// - OutboxEvent (transactional outbox) + ProcessedRollup (exactly-once) make Redis an
// accelerator, never the only copy of a business event; the relay claims events with
// FOR UPDATE SKIP LOCKED so concurrent workers never double-drain.
// - Cohort rollups (TestStat/TestSectionStat/TestQuestionStat) accumulate in Redis and
// flush by batch — never synchronous per submit. Per-student rollups apply inline.
// - Aadhaar/PAN images NOT stored (verified booleans only). timestamptz + FK indexes
// + query-driven indexes + partial uniques + no-hard-delete codified in header.
//
// FIELD TRIMS (latest pass)
// - Dropped redundant/low-value fields: ExamFamily(order,isActive via table removal),
// ExamStage.meritOrQualifying, Question.isActive/source, TestSeries.isSingleton/
// shareSlug, Attempt.resumeCount, Student.baseBranchId/createdVia,
// StudentSeriesUnlock.state/source. BaseConfig slimmed (sectional/marks/negative/
// difficultyMix/cutoff/languageChoice/scribe folded into featureFlags or the
// sections). AttemptQuestion (hot table) dropped stored marks/negativeMarks/
// languageViewed — recomputed by the scoring worker from the pinned version + config.
// - BaseConfig.lockedSectionSwitching dropped — section-return derives from timerTemplate
// (see DESIGN DECISIONS #2). totalQuestions/totalMarks kept as a display cache.
//  ============================================================================


