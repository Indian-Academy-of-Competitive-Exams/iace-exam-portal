  QuestionVersion
  SavedQuestion
}

TableGroup "Tests & Papers" { // color: #2E7D5B
  Test
  PaperQuestion
  QuestionAssignment
  SectionComment
}

TableGroup "Attempts" { // color: #2563A8
  Attempt
  AttemptSheet
}

TableGroup "People & Identity" { // color: #6D4AA8
  Student
  StudentProfile
  Admin
}

TableGroup "Admin Permissions" { // color: #8A4A8F
  AdminFeaturePermission
}

TableGroup "Access: Programs / Branches / Series" { // color: #1F7A8C
  Branch
  TestSeries
  Program
  StudentGrant
  TestProgramUnlock
}

TableGroup "Analytics Rollups" { // color: #3F7E44
