// ============================================================================
// Table groups. Colors are kept as trailing comments: @dbml/core rejects
// `[color: ...]` on a TableGroup (dbdiagram.io-only syntax) and would fail to parse.
// ============================================================================

TableGroup "Exam Taxonomy" { // color: #B83939
  Exam
  ExamStage
}

TableGroup "Base Configs" { // color: #C2703D
  BaseConfig
  BaseConfigModule
  BaseConfigSection
}

TableGroup "Question Bank" { // color: #B8860B
  Subject
