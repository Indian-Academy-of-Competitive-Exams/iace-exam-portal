# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/
*.tgz

# Builds / outputs
# Sourcemaps live inside dist/ and are covered here. They are deliberately
# PRODUCED (the API runs with --enable-source-maps, so a production stack trace
# points at the .ts line) — they are just never committed. Vite emits none for
# the SPAs by default, which is what keeps our source off the public web.
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
# Vite rewrites its config to a temp file next to the original during some runs.
vite.config.*.timestamp-*.mjs

# Caches
.eslintcache
.cache/

# Prisma / local databases
prisma/migrations/dev.db*
*.sqlite
*.sqlite3

# Env / secrets
.env
.env.*
!.env.example
!.env.*.example

# Keys and certificates. Nothing here should ever hold one, which is exactly
# why a stray file must not be one `git add .` away from being published.
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt

# Data dumps and backups. NOT `*.sql` — prisma/migrations/**/migration.sql is
# source and must stay tracked.
*.sql.gz
*.dump
dump.rdb
backups/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.zed/
.history/
*.swp
*.swo
.DS_Store
._*
.AppleDouble
Thumbs.db

# Merge / patch leftovers
*.orig
*.rej

# Agent tooling. Project-level .claude config may be shared; the local override
# holds machine-specific permission grants and must not be. Until now this was
# only saved by one developer's GLOBAL gitignore — invisible protection that
# does not exist on a fresh clone or in CI.
.claude/settings.local.json
.claude/worktrees/

# Docker / local data
docker-data/
*.local

# Uploads (local S3/MinIO scratch, if any)
tmp/

# sonar-scanner working directory
.scannerwork/

# Brainstorming visual companion (local mockups)
.superpowers/

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Working files an agent writes to drive a build: implementation plans, task
# briefs, the specs behind them, research notes, status reports. They are
# scaffolding for one piece of work and go stale the day it lands, and a repo
# full of them buries the handful of documents somebody actually has to read.
# Kept on disk, out of the index. What survives a task goes in the commit body
# or into an architectural doc under docs/, never into a tracked plan.
docs/superpowers/plans/
docs/superpowers/specs/

# The TODO markers lifted out of the source to keep the Sonar gate clean. A
# backlog, not architecture — and one `git add .` from coming back without this.
docs/05-question-bank-follow-ups.md

# Local patches to the installed superpowers plugin — this machine's tooling,
# not the platform's source.
docs/superpowers/patches/

# Read-only audit output: findings, repro scripts and evidence for one review, not source.
audit/
