// ============================================================================
// IACE Platform — V1 data model (PostgreSQL).
//
// Target of record: docs/schema-target.dbml. What Prisma cannot express —
// partial-unique indexes, CHECK constraints, the locked-config immutability
// trigger and the outbox poll index — is hand-written in the migration.
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// Enums
// ============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DifficultyLevel {
  LOW
  MEDIUM
  HIGH
}

enum SupportedLanguage {
  EN
  HI
  TE
}

enum QuestionType {
  SINGLE_MCQ
  TEXT_FIELD
}

// How a TEXT_FIELD answerKey is matched. Lives inside QuestionVersion.answerKey
// JSON, never as a column.
enum AnswerMode {
  NUMERIC
  TEXT
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TestUi {
  CBT
  OMR
  GENERIC
  TYPING
}

enum NavigationPolicy {
  FREE
  FORWARD_ONLY
}

enum LanguageMode {
  SINGLE
  DUAL
}

// Section-return behaviour derives from this: COMPOSITE_FREE may return,
// SECTIONAL_LOCKED / SESSION_MODULE_LOCKED may not, PER_ITEM_TIMED is forward-only.
enum TimerTemplate {
  COMPOSITE_FREE
  SECTIONAL_LOCKED
  SESSION_MODULE_LOCKED
  PER_ITEM_TIMED
}

enum ExamFamily {
  SSC
  RRB
  BANKING
  AP_TS_POLICE
}

enum ExamMode {
  CBT
  OMR
  PSYCHOMETRIC
  SKILL
  PHYSICAL
  INTERVIEW
  DESCRIPTIVE
}

enum MeritType {
  MERIT
  QUALIFYING
}

enum StageDisposition {
  CONDUCTED
  PARTIAL
  CATALOG_ONLY
}

enum TestStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum TestScope {
  FULL
  MODULE
  SECTIONAL
  TOPIC
}

enum EvaluationMode {
  RANKED
  PRACTICE
}

enum PaperBinding {
  FIXED
  GENERATED
}

enum DrawStrategy {
  RANDOM
  NEWEST_FIRST
  LEAST_SERVED
  UNSEEN_FIRST
}

enum PaperQuestionStatus {
  ACTIVE
  DROPPED
  BONUS
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
}

enum AnswerState {
  NOT_VISITED
  NOT_ANSWERED
  ANSWERED
  MARKED_REVIEW
  ANSWERED_MARKED
}

enum NotificationType {
  TEST_ASSIGNED
  RESULT_READY
  ENROLLMENT_ADDED
  GRANT_ADDED
  SERIES_UNLOCKED
  GENERIC
}

enum StudentType {
  ONLINE
  OFFLINE
  NON_IACE
}

enum BranchType {
  PHYSICAL
  VIRTUAL
}

enum ImportSource {
  INDIVIDUAL
  SHEET
  SCRIPT
  SELF_SIGNUP
}

enum UnlockMode {
  AUTO
  REQUEST
  ADMIN
}

// Derived from StudentSeriesUnlock presence; mirrored in @iace/contracts for the
// student-facing catalog.
enum UnlockState {
  LOCKED
  UNLOCKED
}

enum UnlockRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// WRITE covers create + update + delete, and implies READ.
enum PermissionLevel {
  READ
  WRITE
}

// Aligned with AUDIT_FEATURE in @iace/contracts; both sides move to the target
// values (TEST_SERIES / BASE_CONFIG / EXAM_TAXONOMY) together in T9.
enum AuditFeature {
  STUDENT
  STUDENT_PROFILE
  GROUP
  BRANCH
  ADMIN
  QUESTION
  TEST
  EXAM_TYPE
  TAXONOMY_SUBJECT
  TAXONOMY_TOPIC
  TAXONOMY_SUB_TOPIC
  FEATURE_PERMISSION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  BLOCK
  UNBLOCK
  IMPORT
}

enum ActorType {
  ADMIN
  STUDENT
  SCRIPT
  SYSTEM
}

// ============================================================================
// Exam taxonomy — ExamFamily (enum) → Exam → ExamStage
// ============================================================================

model Exam {
  id          String     @id @default(cuid())
  family      ExamFamily
  // Student.enrolledExams holds these codes, so a code is never re-used.
  code        String     @unique
  name        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  stages ExamStage[]

  @@index([family])
}

// The Stage/Paper level — what carries a base config, a series and a test.
model ExamStage {
  id          String           @id @default(cuid())
  examId      String
  stageKey    String           @unique
  name        String
  order       Int              @default(0)
  mode        ExamMode         @default(CBT)
  disposition StageDisposition @default(CONDUCTED)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  exam        Exam         @relation(fields: [examId], references: [id])
  baseConfigs BaseConfig[]
  tests       Test[]
  series      TestSeries[]

  @@index([examId])
  @@index([examId, order])
  @@index([disposition])
}

// ============================================================================
// Base configs — a stage's reusable blueprint. One isDefault per stage (the
// seeded official pattern) plus any number of custom ones. A Test inherits from
// a config rather than copying it; the config locks at first finalize.
// ============================================================================

model BaseConfig {
  id                   String              @id @default(cuid())
  examStageId          String
  name                 String
  isDefault            Boolean             @default(false)
  clonedFromId         String?
  version              Int                 @default(1)
  isActive             Boolean             @default(true)
  locked               Boolean             @default(false)
  totalQuestions       Int
  totalMarks           Decimal             @db.Decimal(8, 2)
  durationSec          Int
  timerTemplate        TimerTemplate       @default(COMPOSITE_FREE)
  navigation           NavigationPolicy    @default(FREE)
  optionalSectionCount Int?
  defaultTestUi        TestUi              @default(CBT)
  languageMode         LanguageMode        @default(SINGLE)
  // Ordered; DUAL renders all of them.
  languages            SupportedLanguage[] @default([])
  shuffleQuestions     Boolean             @default(true)
  shuffleOptions       Boolean             @default(true)
  calculatorEnabled    Boolean             @default(false)
  featureFlags         Json?
  // Which scoring algorithm produced a result — bump to reproduce history exactly.
  scoringVersion       Int                 @default(1)
  createdById          String?
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  examStage  ExamStage           @relation(fields: [examStageId], references: [id])
  clonedFrom BaseConfig?         @relation("BaseConfigLineage", fields: [clonedFromId], references: [id], onDelete: Restrict)
  clones     BaseConfig[]        @relation("BaseConfigLineage")
  modules    BaseConfigModule[]
  sections   BaseConfigSection[]
  tests      Test[]

  @@unique([id, examStageId])
  @@index([examStageId])
  @@index([clonedFromId])
  @@index([isDefault])
}

// Session/module layer above sections. The table and the config seam ship in V1;
// the SESSION_MODULE_LOCKED runtime engine is the deferred part.
model BaseConfigModule {
  id           String @id @default(cuid())
  baseConfigId String
  name         String
  order        Int
  durationSec  Int?

  baseConfig BaseConfig          @relation(fields: [baseConfigId], references: [id], onDelete: Cascade)
  sections   BaseConfigSection[]

  @@unique([baseConfigId, order])
  @@unique([baseConfigId, id])
}

model BaseConfigSection {
  id                String    @id @default(cuid())
  baseConfigId      String
  moduleId          String?
  name              String
  order             Int
  subjectId         String?
  questionCount     Int
  marksPerQuestion  Decimal   @db.Decimal(6, 2)
  negativeMarks     Decimal   @db.Decimal(6, 2)
  durationSec       Int?
  perQuestionSec    Int?
  mandatory         Boolean   @default(true)
  meritOrQualifying MeritType @default(MERIT)
  qualifyingCutoff  Decimal?  @db.Decimal(6, 2)
  difficultyMix     Json?

  baseConfig     BaseConfig        @relation(fields: [baseConfigId], references: [id], onDelete: Cascade)
  module         BaseConfigModule? @relation(fields: [baseConfigId, moduleId], references: [baseConfigId, id], onDelete: Restrict, onUpdate: NoAction)
  subject        Subject?          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  paperQuestions PaperQuestion[]
  attemptItems   AttemptQuestion[]
  sectionStats   TestSectionStat[]

  @@unique([baseConfigId, moduleId, order])
  @@unique([baseConfigId, id])
  @@index([subjectId])
  @@index([moduleId])
}

// ============================================================================
// Question bank — Subject → Topic → Question → QuestionVersion.
// Question is stable identity; every edit inserts a new immutable version.
// ============================================================================

model Subject {
  id   String  @id @default(cuid())
  name String  @unique
  code String? @unique

  topics       Topic[]
  questions    Question[]
  sections     BaseConfigSection[]
  subjectStats StudentSubjectStat[]
}

model Topic {
  id        String @id @default(cuid())
  subjectId String
  name      String

  subject   Subject    @relation(fields: [subjectId], references: [id])
  questions Question[]

  @@unique([subjectId, name])
}

model Question {
  id               String          @id @default(cuid())
  questionCode     String?         @unique
  type             QuestionType    @default(SINGLE_MCQ)
  subjectId        String
  topicId          String?
  difficulty       DifficultyLevel
  status           QuestionStatus  @default(ACTIVE)
  currentVersionId String?
  // Namespaced `key:value` convention — paper:, set:, pyq:, src:, topic:.
  tags             String[]        @default([])
  stemHash         String?
  // Times used in a FIXED paper; incremented atomically at finalize.
  fixedUseCount    Int             @default(0)
  createdById      String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  subject        Subject            @relation(fields: [subjectId], references: [id])
  topic          Topic?             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  currentVersion QuestionVersion?   @relation("QuestionCurrentVersion", fields: [id, currentVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: NoAction)
  versions       QuestionVersion[]  @relation("QuestionVersions")
  paperQuestions PaperQuestion[]
  attemptItems   AttemptQuestion[]
  questionStats  TestQuestionStat[]

  @@index([subjectId, difficulty, status])
  @@index([topicId])
  @@index([stemHash])
  @@index([fixedUseCount])
  @@index([tags], type: Gin)
}

// Immutable: an edit inserts a new row and repoints Question.currentVersionId.
// Options live in `options` so one read is the whole question on the exam path.
model QuestionVersion {
  id          String   @id @default(cuid())
  questionId  String
  version     Int
  content     Json
  options     Json?
  answerKey   Json?
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  question       Question          @relation("QuestionVersions", fields: [questionId], references: [id])
  currentOf      Question[]        @relation("QuestionCurrentVersion")
  paperQuestions PaperQuestion[]
  attemptItems   AttemptQuestion[]

  @@unique([questionId, version])
  @@unique([questionId, id])
}

// ============================================================================
// Tests & papers — a Test inherits shape from its BaseConfig and adds only
// scope, evaluation mode and how the paper is drawn.
// ============================================================================

model Test {
  id                 String         @id @default(cuid())
  title              String?
  baseConfigId       String
  // Denormalised from BaseConfig so the composite FK below is always enforced.
  examStageId        String
  scope              TestScope      @default(FULL)
  scopeRef           Json?
  evaluationMode     EvaluationMode @default(RANKED)
  paperBinding       PaperBinding   @default(FIXED)
  maxRetakes         Int?
  questionPoolFilter Json?
  drawStrategy       DrawStrategy   @default(RANDOM)
  status             TestStatus     @default(DRAFT)
  isLocked           Boolean        @default(false)
  // Optimistic lock — finalize is a conditional UPDATE ... WHERE version = $n.
  version            Int            @default(0)
  finalizedAt        DateTime?      @db.Timestamptz(3)
  createdById        String?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  baseConfig     BaseConfig         @relation(fields: [baseConfigId, examStageId], references: [id, examStageId], onDelete: Restrict, onUpdate: NoAction)
  examStage      ExamStage          @relation(fields: [examStageId], references: [id])
  paperQuestions PaperQuestion[]
  attempts       Attempt[]
  series         TestSeriesTest[]
  notifications  Notification[]
  stat           TestStat?
  sectionStats   TestSectionStat[]
  questionStats  TestQuestionStat[]

  @@unique([id, baseConfigId])
  @@index([baseConfigId])
  @@index([examStageId])
  @@index([status])
}

// FIXED papers only: drawn once at finalize, frozen, shared by every student.
model PaperQuestion {
  id                  String              @id @default(cuid())
  testId              String
  baseConfigId        String
  baseConfigSectionId String
  questionId          String
  questionVersionId   String
  order               Int
  marks               Decimal             @db.Decimal(6, 2)
  negativeMarks       Decimal             @db.Decimal(6, 2)
  status              PaperQuestionStatus @default(ACTIVE)

  test              Test               @relation(fields: [testId, baseConfigId], references: [id, baseConfigId], onDelete: Cascade, onUpdate: NoAction)
  baseConfigSection BaseConfigSection  @relation(fields: [baseConfigId, baseConfigSectionId], references: [baseConfigId, id], onDelete: Restrict, onUpdate: NoAction)
  question          Question           @relation(fields: [questionId], references: [id])
  questionVersion   QuestionVersion    @relation(fields: [questionId, questionVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: NoAction)
  attemptItems      AttemptQuestion[]  @relation("AttemptItemPaper")
  attemptSections   AttemptQuestion[]  @relation("AttemptItemPaperSection")
  questionStats     TestQuestionStat[]

  @@unique([testId, questionId])
  @@unique([testId, order])
  @@unique([id, questionId, questionVersionId])
  @@unique([id, baseConfigSectionId])
  @@index([questionId])
  @@index([questionVersionId])
  @@index([baseConfigId, baseConfigSectionId])
}

// ============================================================================
// Attempts — live state and scored result in one table.
// ============================================================================

model Attempt {
  id               String              @id @default(cuid())
  testId           String
  studentId        String
  attemptNo        Int                 @default(1)
  // True only for the single ranked attempt; the cohort rollup fires on it alone.
  isGraded         Boolean             @default(true)
  status           AttemptStatus       @default(IN_PROGRESS)
  startedAt        DateTime            @default(now()) @db.Timestamptz(3)
  // Server-authoritative deadline; the client clock only counts down to it.
  endsAt           DateTime            @db.Timestamptz(3)
  submittedAt      DateTime?           @db.Timestamptz(3)
  evaluatedAt      DateTime?           @db.Timestamptz(3)
  shuffleSeed      Int
  languages        SupportedLanguage[] @default([])
  sectionState     Json?
  score            Decimal?            @db.Decimal(8, 2)
  correctCount     Int?
  wrongCount       Int?
  unattemptedCount Int?
  sectionScores    Json?
  // Snapshots. The live rank and percentile are always read from Redis.
  lastRank         Int?
  lastPercentile   Decimal?            @db.Decimal(5, 2)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  test             Test              @relation(fields: [testId], references: [id])
  student          Student           @relation(fields: [studentId], references: [id])
  questions        AttemptQuestion[]
  processedRollups ProcessedRollup[]
  topperOf         TestStat[]

  @@unique([testId, studentId, attemptNo])
  @@index([studentId, createdAt])
  @@index([testId, status])
  @@index([testId, score])
}

// One row per question served in an attempt, plus the student's response.
// paperQuestionId null ⇔ GENERATED, not null ⇔ FIXED. The durable row is an
// idempotent UPSERT flushed by a single writer; Redis holds the live state.
model AttemptQuestion {
  attemptId           String
  questionId          String
  paperQuestionId     String?
  questionVersionId   String
  baseConfigSectionId String
  order               Int
  // An option id inside QuestionVersion.options — app-validated, not a DB FK.
  selectedOptionId    String?
  typedAnswer         String?
  state               AnswerState @default(NOT_VISITED)
  timeSpentSec        Int         @default(0)
  isCorrect           Boolean?
  marksAwarded        Decimal?    @db.Decimal(6, 2)
  answeredAt          DateTime?   @db.Timestamptz(3)

  attempt           Attempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question          @relation(fields: [questionId], references: [id])
  questionVersion   QuestionVersion   @relation(fields: [questionId, questionVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: NoAction)
  paperItem         PaperQuestion?    @relation("AttemptItemPaper", fields: [paperQuestionId, questionId, questionVersionId], references: [id, questionId, questionVersionId], onDelete: Restrict, onUpdate: NoAction)
  paperSection      PaperQuestion?    @relation("AttemptItemPaperSection", fields: [paperQuestionId, baseConfigSectionId], references: [id, baseConfigSectionId], onDelete: Restrict, onUpdate: NoAction)
  baseConfigSection BaseConfigSection @relation(fields: [baseConfigSectionId], references: [id])

  @@id([attemptId, questionId])
  @@index([questionId])
  @@index([paperQuestionId])
  @@index([baseConfigSectionId])
  @@index([attemptId, order])
}

// ============================================================================
// People — Student and Admin are separate identities with separate logins.
// ============================================================================

// Login is allowed while isActive and deletedAt is null; isTestBlocked gates
// starting an attempt only. mobile / externalRef carry a partial unique index
// (WHERE deletedAt IS NULL) written in the migration, so a soft-deleted row
// releases its number.
model Student {
  id                String            @id @default(cuid())
  mobile            String
  externalRef       String?
  studentType       StudentType
  enrolledFamilies  ExamFamily[]      @default([])
  // Program.code values — the student is a candidate for these.
  programs          String[]          @default([])
  // Exam.code values, app-validated against Exam.
  enrolledExams     String[]          @default([])
  currentBranchId   String?
  pinHash           String?
  pinIsDefault      Boolean           @default(true)
  fullName          String?
  preferredLanguage SupportedLanguage @default(EN)
  preTestReady      Boolean           @default(false)
  profileCompleted  Boolean           @default(false)
  isActive          Boolean           @default(true)
  isTestBlocked     Boolean           @default(false)
  deletedAt         DateTime?         @db.Timestamptz(3)
  createdById       String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  profile        StudentProfile?
  currentBranch  Branch?               @relation(fields: [currentBranchId], references: [id], onDelete: Restrict)
  attempts       Attempt[]
  grants         StudentGrant[]
  unlocks        StudentSeriesUnlock[]
  unlockRequests SeriesUnlockRequest[]
  notifications  Notification[]
  stat           StudentStat?
  subjectStats   StudentSubjectStat[]

  @@index([mobile])
  @@index([externalRef])
  @@index([enrolledFamilies], type: Gin)
  @@index([enrolledExams], type: Gin)
  @@index([programs], type: Gin)
  @@index([currentBranchId])
}

// Aadhaar/PAN images are never stored here — only the verification status.
// Writes to motherName/fatherName/dob must recompute Student.preTestReady.
model StudentProfile {
  id                String    @id @default(cuid())
  studentId         String    @unique
  motherName        String?
  fatherName        String?
  dob               DateTime? @db.Date
  email             String?
  address           String?
  gender            Gender?
  photoUrl          String?
  aadhaarVerified   Boolean   @default(false)
  panVerified       Boolean   @default(false)
  tenthMarksheetUrl String?
  educationDetails  Json?
  pastExamHistory   Json?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// The first super admin is inserted by SQL — nothing in the codebase creates one.
// No soft delete: createdById on everything they made points here.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String?
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  // Explicit, never inferred from having no AdminBranch rows.
  allBranches  Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  branches    AdminBranch[]
  permissions AdminFeaturePermission[]
}

model AdminBranch {
  adminId  String
  branchId String

  admin  Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([adminId, branchId])
  @@index([branchId])
}

// One row per grant. featureKey mirrors the code-owned FEATURE_KEYS enum and is
// app-validated — there is no Feature table and the UI never registers a key.
model AdminFeaturePermission {
  adminId    String
  featureKey String
  level      PermissionLevel

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([adminId, featureKey, level])
  @@index([featureKey])
}

// ============================================================================
// Access — branches, programs, series. A student reaches a series by exam
// match, program match or an explicit grant, gated by BranchTestConfig.
// ============================================================================

// name carries a partial unique index (WHERE deletedAt IS NULL) from the migration.
model Branch {
  id        String     @id @default(cuid())
  name      String
  type      BranchType
  isActive  Boolean    @default(true)
  deletedAt DateTime?  @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  students    Student[]
  admins      AdminBranch[]
  testConfigs BranchTestConfig[]

  @@index([name])
}

// A new coaching variant is one INSERT, never a migration.
model Program {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  series TestSeries[]
}

// The unit of offering — a test reaches students only through a series.
// programCode null = exam/family access; set = program-only.
model TestSeries {
  id                   String     @id @default(cuid())
  name                 String
  description          String?
  examStageId          String?
  programCode          String?
  sequentialTests      Boolean    @default(false)
  prerequisiteSeriesId String?
  unlockMode           UnlockMode @default(AUTO)
  // Pricing only — free is not open access.
  isFree               Boolean    @default(false)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  examStage          ExamStage?            @relation(fields: [examStageId], references: [id], onDelete: Restrict)
  program            Program?              @relation(fields: [programCode], references: [code], onDelete: Restrict)
  prerequisiteSeries TestSeries?           @relation("SeriesPrerequisite", fields: [prerequisiteSeriesId], references: [id], onDelete: Restrict)
  dependentSeries    TestSeries[]          @relation("SeriesPrerequisite")
  tests              TestSeriesTest[]
  grants             StudentGrant[]
  unlocks            StudentSeriesUnlock[]
  unlockRequests     SeriesUnlockRequest[]
  branchConfigs      BranchTestConfig[]
  notifications      Notification[]

  @@index([examStageId])
  @@index([programCode])
  @@index([prerequisiteSeriesId])
}

model TestSeriesTest {
  testSeriesId String
  testId       String
  order        Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  createdById  String?

  testSeries TestSeries @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)
  test       Test       @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([testSeriesId, testId])
  @@index([testId])
}

// The escape hatch for access that is not exam-, program- or branch-derivable.
model StudentGrant {
  studentId    String
  testSeriesId String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  createdById  String?

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testSeries TestSeries @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)

  @@id([studentId, testSeriesId])
  @@index([testSeriesId])
}

model StudentSeriesUnlock {
  id           String    @id @default(cuid())
  studentId    String
  testSeriesId String
  unlockedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testSeries TestSeries @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)

  @@unique([studentId, testSeriesId])
  @@index([testSeriesId])
}

// One open request per (student, series) — partial unique WHERE status='PENDING'
// lives in the migration.
model SeriesUnlockRequest {
  id           String              @id @default(cuid())
  studentId    String
  testSeriesId String
  status       UnlockRequestStatus @default(PENDING)
  requestedAt  DateTime            @default(now()) @db.Timestamptz(3)
  decidedAt    DateTime?           @db.Timestamptz(3)
  decidedById  String?

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testSeries TestSeries @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)

  @@index([studentId, testSeriesId, status])
  @@index([testSeriesId, status])
}

// Access enable plus the default availability window, per (branch, series).
model BranchTestConfig {
  id           String    @id @default(cuid())
  branchId     String
  testSeriesId String
  enabled      Boolean   @default(true)
  startAt      DateTime? @db.Timestamptz(3)
  endAt        DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  testSeries TestSeries @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)

  @@unique([branchId, testSeriesId])
  @@index([testSeriesId])
}

// ============================================================================
// Central audit — data CRUD and imports only, never exam interactions.
// ============================================================================

model ImportLog {
  id         String       @id @default(cuid())
  feature    AuditFeature
  source     ImportSource
  actorId    String?
  fileS3Key  String?
  total      Int          @default(0)
  created    Int          @default(0)
  updated    Int          @default(0)
  skipped    Int          @default(0)
  failed     Int          @default(0)
  status     String
  errors     Json?
  startedAt  DateTime     @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?    @db.Timestamptz(3)

  rows RowActionLog[]

  @@index([feature, startedAt])
}

model RowActionLog {
  id          String       @id @default(cuid())
  feature     AuditFeature
  entityId    String
  // The label as it was, so the log survives a rename or a delete.
  entityLabel String?
  action      AuditAction
  actorType   ActorType
  actorId     String?
  changed     Json?
  importLogId String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  importLog ImportLog? @relation(fields: [importLogId], references: [id], onDelete: Restrict)

  @@index([feature, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([importLogId])
}

// ============================================================================
// Durability — transactional outbox and rollup idempotency.
// ============================================================================

// Written in the same transaction as the state change. A relay claims rows with
// FOR UPDATE SKIP LOCKED; the poll is served by a partial index on pending rows.
model OutboxEvent {
  id            String    @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  processedAt   DateTime? @db.Timestamptz(3)

  @@index([processedAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
}

// Makes each attempt count exactly once per rollup, across worker retries.
model ProcessedRollup {
  attemptId   String
  rollupType  String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, rollupType])
}

// ============================================================================
// Notifications — in-app now, push behind the same sender seam later.
// ============================================================================

model Notification {
  id           String           @id @default(cuid())
  studentId    String
  type         NotificationType
  title        String
  body         String?
  testId       String?
  testSeriesId String?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test       Test?       @relation(fields: [testId], references: [id])
  testSeries TestSeries? @relation(fields: [testSeriesId], references: [id])

  @@index([studentId, createdAt])
  @@index([studentId, isRead])
  @@index([testId])
  @@index([testSeriesId])
}

// ============================================================================
// Analytics rollups — sums and counts only, updated by idempotent deltas.
// Cohort rows accumulate in Redis and flush by batch; per-student rows may be
// applied inline. Averages are derived on read.
// ============================================================================

model StudentStat {
  studentId        String    @id
  testsAttempted   Int       @default(0)
  testsEvaluated   Int       @default(0)
  sumScore         Decimal   @default(0) @db.Decimal(16, 2)
  sumPercentile    Decimal   @default(0) @db.Decimal(16, 2)
  bestPercentile   Decimal?  @db.Decimal(5, 2)
  totalAnswered    Int       @default(0)
  totalCorrect     Int       @default(0)
  totalWrong       Int       @default(0)
  totalUnattempted Int       @default(0)
  sumTimeSec       BigInt    @default(0)
  practiceAttempts Int       @default(0)
  lastAttemptAt    DateTime? @db.Timestamptz(3)
  // Watermark for drift detection and targeted rebuilds.
  computedThrough  DateTime? @db.Timestamptz(3)
  computedAt       DateTime  @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Bucketed by test type so the strength map filters by kind; "overall" sums the
// buckets on read. Practice attempts feed this but never the cohort rollups.
model StudentSubjectStat {
  studentId      String
  subjectId      String
  scope          TestScope
  evaluationMode EvaluationMode
  attempted      Int            @default(0)
  correct        Int            @default(0)
  wrong          Int            @default(0)
  sumTimeSec     BigInt         @default(0)
  computedAt     DateTime       @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@id([studentId, subjectId, scope, evaluationMode])
  @@index([subjectId])
}

model TestStat {
  testId           String   @id
  attemptCount     Int      @default(0)
  evaluatedCount   Int      @default(0)
  sumScore         Decimal  @default(0) @db.Decimal(18, 2)
  maxScore         Decimal? @db.Decimal(8, 2)
  minScore         Decimal? @db.Decimal(8, 2)
  sumTimeSec       BigInt   @default(0)
  scoreHistogram   Json?
  topperAttemptId  String?
  // Watermark: rows already folded in, so a rebuild cannot double-count.
  attemptsIncluded Int      @default(0)
  computedAt       DateTime @db.Timestamptz(3)

  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  topperAttempt Attempt? @relation(fields: [topperAttemptId], references: [id])

  @@index([topperAttemptId])
}

model TestSectionStat {
  testId              String
  baseConfigSectionId String
  attempted           Int      @default(0)
  sumScore            Decimal  @default(0) @db.Decimal(18, 2)
  sumTimeSec          BigInt   @default(0)
  computedAt          DateTime @db.Timestamptz(3)

  test              Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  baseConfigSection BaseConfigSection @relation(fields: [baseConfigSectionId], references: [id])

  @@id([testId, baseConfigSectionId])
  @@index([baseConfigSectionId])
}

// Item analysis and distractor counts for FIXED papers.
model TestQuestionStat {
  testId          String
  paperQuestionId String
  questionId      String
  attemptedCount  Int      @default(0)
  correctCount    Int      @default(0)
  wrongCount      Int      @default(0)
  skippedCount    Int      @default(0)
  sumTimeSec      BigInt   @default(0)
  optionCounts    Json?
  pValue          Decimal? @db.Decimal(5, 4)
  discrimination  Decimal? @db.Decimal(6, 4)
  computedAt      DateTime @db.Timestamptz(3)

  test          Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  paperQuestion PaperQuestion @relation(fields: [paperQuestionId], references: [id], onDelete: Cascade)
  question      Question      @relation(fields: [questionId], references: [id])

  @@id([testId, paperQuestionId])
  @@index([paperQuestionId])
  @@index([questionId])
}
