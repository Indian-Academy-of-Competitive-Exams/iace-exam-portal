// ============================================================================
// IACE Platform — V1 Mock-Test Feature — Prisma schema (PostgreSQL) — v2
//
// Rework notes (what changed and why):
// - Student and Admin are now SEPARATE tables (different identity, login, rules).
// - NO OTP or Device table — OTP, sessions, and device binding all live in Redis.
// - StudentProfile (1:1) holds extended personal data; Student.profileCompleted
//   is gated on photo + DOB + gender + Aadhaar + PAN.
// - Permissions = Feature (one row per product sector, keyed by FEATURE_KEYS)
//   + FeaturePermission (one row per feature+level, holding a denormalized
//   adminIds array). Replaced the old Page table and the Admin ⇄ Page M:N.
//   Super admins bypass feature checks in app logic.
// - Many-to-many junctions (Branch⇄Group, Test⇄TestSeries, Group⇄TestSeries) are
//   IMPLICIT — Prisma manages the hidden join tables, so they are not models
//   here. Student⇄Group is NOT one of them: a student reaches a group through
//   `enrolledExams` or `directGroupIds`, and there is no membership row.
// - Question text/options are stored as localized JSON (row-per-language tables
//   removed); option identity stays relational (stable id + isCorrect) so the
//   answer key survives shuffling and AttemptAnswer can FK the chosen option.
// - No media table: images live as S3 URLs inline in the localized JSON
//   (Question.content / QuestionOption.text), next to $LaTeX$ equations.
// - Result merged into Attempt (scored fields fill in on evaluation).
//   totalCandidates removed — "rank out of N" is derived live from Redis.
// - TestShareLink removed — the share link is a slug on Test, generated in UI.
// - Marks use Decimal(6,2) for exact 0.25 / 0.33 / 0.50.
// - "createdById" audit fields are plain Admin ids (no FK) to avoid clutter.
//
// ---------------------------------------------------------------------------
// Conventions every model follows (docs/03 §9)
//
// TIMESTAMPS — every table has `createdAt @default(now())` and
// `updatedAt @default(now()) @updatedAt`. The DB-level default on `updatedAt`
// is not decoration: without it, adding the column to a table that already has
// rows is an ALTER Postgres refuses, and Prisma writes the value on every
// update anyway, so the default only ever covers a row inserted by something
// that is not Prisma.
//
// SOFT DELETE — `deletedAt DateTime?` on records that must be recoverable or
// auditable: Student, Admin, Question, Test, Group, Branch, Subject, Topic,
// SubTopic, Notification. Deliberately NOT on the rest:
//   - StudentProfile, QuestionOption, TestSection, BaseConfigSection,
//     PaperQuestion — parts of a parent, and they die with it (cascade). A
//     soft-deleted option would still be in the answer key.
//   - Attempt, AttemptAnswer — never deleted at all. An attempt is the record
//     of a test somebody sat; the highest-volume table in the system does not
//     need a column that is always null.
//   - ExamType, BaseConfig, TestSeries — retired by a flag or by cloning
//     (`isActive`, `locked`), which is the existing, more informative answer.
//
// `Admin` deliberately has none — see the note on that model.
// NOTHING READS `deletedAt` YET on the models that have it. The column is here so the decision is made
// once, per model, before there is data to migrate — every query still sees
// every row. When soft delete IS implemented, note that a deleted row still
// occupies its unique slot: Student.mobile, Branch.name, SubTopic.name and
// Group[examType, name] would all refuse a replacement with the same name
// until the deleted one is purged.
// ---------------------------------------------------------------------------
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// Enums
// ============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DifficultyLevel {
  LOW
  MEDIUM
  HIGH
}

enum QuestionType {
  SINGLE_MCQ // V1. Extensible later.
  TEXT_FIELD // a typed answer, compared against answerKey rather than chosen
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TestUi {
  CBT // standard government CBT interface (primary V1 build)
  GENERIC // lighter test screen (only if time permits)
}

enum LanguageMode {
  SINGLE // student picks one language (optional per-question toggle)
  DUAL // show two languages together (e.g. English + Hindi), stem + options
}

enum TestStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PaperQuestionStatus {
  ACTIVE
  DROPPED // excluded from scoring
  BONUS // awarded to everyone
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
}

enum AnswerState {
  NOT_VISITED
  NOT_ANSWERED
  ANSWERED
  MARKED_REVIEW
  ANSWERED_MARKED
}

enum NotificationType {
  TEST_ASSIGNED
  RESULT_READY
  GENERIC
}

// The enums below mirror the const objects in @iace/contracts EXACTLY — the
// guard, the importer and the UI compare the same strings, so a divergence here
// is a silent refusal. prisma-enums.unit.test.ts holds the two sides together.

enum StudentType {
  ONLINE
  OFFLINE
  NON_IACE
}

enum GroupType {
  GLOBAL
  EXAM
  PROGRAM
  SCHOLARSHIP
  NON_IACE
}

enum BranchType {
  PHYSICAL
  VIRTUAL
}

enum ImportSource {
  INDIVIDUAL
  SHEET
  SCRIPT
  SELF_SIGNUP
}

enum AuditFeature {
  STUDENT
  STUDENT_PROFILE
  GROUP
  BRANCH
  ADMIN
  QUESTION
  TEST
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  IMPORT
}

// Wider than ActorTypes in @iace/contracts, which decides which table a token's
// identity lives in: nothing signs in as SCRIPT or SYSTEM.
enum AuditActorType {
  ADMIN
  STUDENT
  SCRIPT
  SYSTEM
}

// ============================================================================
// People — Student and Admin are separate
// ============================================================================

// Signup: MOBILE + OTP (verifies the number). Every later login: a 4-digit PIN
// (pinHash). OTP also resets a forgotten PIN. OTP + sessions + device binding all
// live in Redis. Rate-limit / lock PIN attempts in Redis.
model Student {
  id                String       @id @default(cuid())
  mobile            String       @unique // only mandatory field
  // The id this student carries in the main portal. Unique, so a re-sync of the
  // same roster reconciles onto the row it made last time instead of doubling it.
  externalRef       String?      @unique
  studentType       StudentType
  // ExamType codes, not ids: the WHAT a student is here for. An EXAM/PROGRAM
  // group is reached by matching this, so no membership row exists for it.
  enrolledExams     String[]     @default([])
  program           String?
  // 4-digit login PIN, argon2id-hashed with a server-side pepper. NOT unique:
  // it is only ever checked against the one student a mobile number resolves to,
  // so two students sharing a PIN is unremarkable and invisible to both.
  pinHash           String?
  // True while the PIN is one the INSTITUTE set, not one the student chose —
  // bulk imports seed the first four digits of the mobile number so a roster
  // can sign in on day one. It is guessable by anyone who knows the number, so
  // it is tracked rather than forgotten: "has signed in" means a PIN of their
  // own, and the student is prompted to replace this one.
  pinIsDefault      Boolean      @default(false)
  fullName          String?
  preferredLanguage String       @default("en")
  // preTestReady: minimal details present (mother's name + father's name + DOB) —
  // the light gate asked before starting a test. profileCompleted: the FULL
  // profile (photo, gender, Aadhaar, PAN, address, education…) — optional, only
  // drives a gentle "complete your profile" prompt, never blocks.
  preTestReady      Boolean      @default(false)
  profileCompleted  Boolean      @default(false)
  // The groups granted to this student ALONE — scholarship and non-IACE. Not
  // FK-enforced, so deleting a group prunes the id from every student holding it.
  directGroupIds    String[]     @default([])
  // The branch they started at, and the one they attend now: access and
  // scheduling read `currentBranchId`, `baseBranchId` is history.
  baseBranchId      String?
  currentBranchId   String?
  // Three separate states, deliberately. `isActive` false cannot sign in;
  // `isTestBlocked` signs in and sees history but cannot start a test; `deletedAt` is gone.
  isActive          Boolean      @default(true)
  isTestBlocked     Boolean      @default(false)
  createdVia        ImportSource @default(INDIVIDUAL)
  createdById       String? // audit (Admin id); null for a self-signup or a script
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  deletedAt         DateTime? // soft delete — see the conventions note above

  profile       StudentProfile?
  baseBranch    Branch?         @relation("StudentBaseBranch", fields: [baseBranchId], references: [id])
  currentBranch Branch?         @relation("StudentCurrentBranch", fields: [currentBranchId], references: [id])
  attempts      Attempt[]
  notifications Notification[]

  // GIN on both arrays: every access question is a contains ("students enrolled
  // in this exam", "students granted this group"), which a btree cannot answer.
  @@index([enrolledExams], type: Gin)
  @@index([directGroupIds], type: Gin)
  @@index([currentBranchId])
}

// Admins log in with EMAIL + OTP (OTP handled in Redis). The FIRST super admin
// is inserted by hand (see the README) — nothing in the codebase creates one.
// After that, super admins create admins/super admins and grant feature access.
// Super admins bypass feature checks in app logic.
//
// NO `deletedAt`, deliberately, and against the general policy in docs/03 §9.
// An Admin row is never removed: `createdById` on everything they made points
// at it, so the row has to survive regardless. `isActive` already carries the
// only state that exists. Having both meant a second flag nothing wrote and
// three auth paths read as "this row is gone" — set by hand it silently denied
// sign-in to a real account, twice.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String?
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  // The branches a branch-scoped admin may manage. EMPTY MEANS ALL, which is
  // every admin today — nothing filters on it until the branch panel ships.
  branchIds    String[] @default([])
  createdById  String? // audit: Admin who created this admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// WRITE covers create + update + delete, and implies READ. Mirrors
// PERMISSION_LEVELS in @iace/contracts EXACTLY — the guard, the UI and this
// enum all compare the same strings, so a divergence here is a silent denial.
enum PermissionLevel {
  READ
  WRITE
}

// One row per sector of the product an admin can be granted. `key` is a value
// from FEATURE_KEYS in @iace/contracts (SCREAMING_SNAKE_CASE).
//
// NOT seeded. A super admin registers each row from the Features screen, and a
// key with no row grants nobody anything — the safe direction to fail.
model Feature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  permissions FeaturePermission[]
}

// Who holds a given level on a given feature.
//
// `adminIds` is a DENORMALIZED grant list, deliberately: the question asked on
// every single request is "which features does THIS admin hold", and a string[]
// answers it in one indexed read instead of a join table lookup per request.
// The cost is that it is not FK-enforced, which is why deactivating an admin
// prunes their id from every row in the same transaction as the soft-delete —
// otherwise a deactivated admin's grants linger and reappear if the id is ever
// reused.
//
// Exactly two rows exist per feature (READ and WRITE), both created with the
// feature itself, so a grant is always an array update and never an upsert.
model FeaturePermission {
  id        String          @id @default(cuid())
  featureId String
  level     PermissionLevel
  adminIds  String[]        @default([])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, level])
  // GIN, because every lookup is a contains: "rows whose adminIds holds X".
  // A btree cannot answer that on an array.
  @@index([adminIds], type: Gin)
}

// Extended personal data (1:1 with Student). The only PRE-TEST required fields
// are motherName + fatherName + dob (drive Student.preTestReady). Everything
// else — photo, gender, Aadhaar, PAN, address, education, past-exam history — is
// optional, filled whenever the student wants (a gentle prompt, not a gate).
// All uploaded documents are S3 URLs.
model StudentProfile {
  id               String    @id @default(cuid())
  studentId        String    @unique
  motherName       String? // pre-test minimal
  fatherName       String? // pre-test minimal
  dob              DateTime? @db.Date // pre-test minimal
  email            String?
  address          String?
  gender           Gender?
  photoUrl         String?
  aadhaarUrl       String? // verification record
  panUrl           String? // verification record
  educationDetails Json? // [{ level, board, institution, year, percentage }]
  pastExamHistory  Json? // self-reported external govt-exam attempts (not platform Attempts)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Question bank
// ============================================================================

model Subject {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime? // soft delete — see the conventions note above

  topics             Topic[]
  questions          Question[]
  baseConfigSections BaseConfigSection[]
  testSections       TestSection[]
}

model Topic {
  id        String    @id @default(cuid())
  subjectId String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime? // soft delete — see the conventions note above

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subTopics SubTopic[] // implicit M:N — a sub-topic is shared, not owned
  questions Question[]

  @@unique([subjectId, name])
}

// The third level of the taxonomy, and the only one that is SHARED.
//
// A sub-topic hangs off topics, never off a Subject: "PERCENTAGES" means
// something under Arithmetic and nothing at all under Quantitative Aptitude as
// a whole. But the same sub-topic recurs under several topics — percentages are
// drilled under Arithmetic and again under Data Interpretation, in Quant and in
// Banking alike — so it is its own row joined many-to-many, not a child owned
// by one parent. It reaches a second SUBJECT only through a topic in that
// subject; there is deliberately no Subject relation here to reach it any
// other way.
//
// name is unique across the whole table, which is the point: a second
// "PERCENTAGES" row would split the very per-sub-topic analytics the sharing
// exists to join up. So the admin screen and the importer must MATCH an
// existing sub-topic before creating one — the way the group importer resolves
// a name rather than minting a duplicate.
model SubTopic {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime? // soft delete — see the conventions note above

  topics    Topic[]
  questions Question[]
}

// Localized content lives in JSON: content = { "en": { "stem": "...",
// "solution": "..." }, "hi": { ... } }. English required (validated in app).
// Each field is rich content and may hold text, inline $LaTeX$ equations,
// and inline S3 image URLs (a question can be image-only).
model Question {
  id                   String          @id @default(cuid())
  questionCode         String?         @unique
  type                 QuestionType    @default(SINGLE_MCQ)
  subjectId            String
  topicId              String?
  // Only meaningful together with topicId, and only when that sub-topic is
  // linked to that topic. No FK can state that — the link lives in the
  // many-to-many — so the service checks it on write. See SubTopic above.
  subTopicId           String?
  difficulty           DifficultyLevel
  defaultMarks         Decimal?        @db.Decimal(6, 2)
  defaultNegativeMarks Decimal?        @db.Decimal(6, 2)
  status               QuestionStatus  @default(ACTIVE)
  // Retired rather than removed: excluded from every future draw and hidden
  // from the bank, while the papers that already hold it are untouched.
  isActive             Boolean         @default(true)
  content              Json // { "<lang>": { "stem": <rich>, "solution": <rich> } }
  // TEXT_FIELD only: { mode, answers: { "<lang>": "..." }, tolerance }
  answerKey            Json?
  tags                 String[]        @default([])
  // Where it came from: { kind: MANUAL | IMPORT, importLogId, line }
  source               Json?
  stemHash             String? // dedup detection
  createdById          String? // audit (Admin id)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt
  deletedAt            DateTime? // soft delete — see the conventions note above

  subject        Subject          @relation(fields: [subjectId], references: [id])
  topic          Topic?           @relation(fields: [topicId], references: [id])
  subTopic       SubTopic?        @relation(fields: [subTopicId], references: [id])
  options        QuestionOption[]
  paperQuestions PaperQuestion[]

  @@index([subjectId, difficulty, status]) // auto-draw filter
  @@index([isActive])
  @@index([topicId])
  @@index([subTopicId])
  @@index([stemHash])
}

// Stable option identity; correctness keyed here (survives shuffle/edit).
// text = { "en": <rich>, "hi": <rich> } — an option may be plain text, an
// $LaTeX$ equation, an inline S3 image URL, or a mix (image-only options OK).
model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  position   Int // authored slot 1..n: import index + canonical order for deterministic shuffle
  isCorrect  Boolean  @default(false)
  text       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@unique([questionId, position])
}

// ============================================================================
// Exam types & reusable base configs
// ============================================================================

model ExamType {
  id          String   @id @default(cuid())
  /// UPPERCASE letters/digits, single-spaced — `Group.examType` and
  /// `Student.enrolledExams` store this string, with no relation to follow.
  code        String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  baseConfigs BaseConfig[]
  tests       Test[]
}

model BaseConfig {
  id         String  @id @default(cuid())
  examTypeId String
  name       String
  isActive   Boolean @default(true)
  // Set true once ANY test created from this config has its first attempt.
  // While locked, the config and its sections are read-only — to change it, the
  // admin CLONES it into a new config. (Existing tests are snapshots, unaffected.)
  locked     Boolean @default(false)

  totalQuestions         Int
  totalMarks             Decimal      @db.Decimal(8, 2)
  durationSec            Int
  sectionalTiming        Boolean      @default(false)
  lockedSectionSwitching Boolean      @default(false)
  optionalSectionCount   Int?
  calculatorEnabled      Boolean      @default(false)
  defaultTestUi          TestUi       @default(CBT)
  languageMode           LanguageMode @default(SINGLE)
  languages              String[]     @default(["en"]) // ordered; DUAL shows all of them
  shuffleQuestions       Boolean      @default(true)
  shuffleOptions         Boolean      @default(true)
  marksPerQuestion       Decimal?     @db.Decimal(6, 2)
  negativeMarks          Decimal?     @db.Decimal(6, 2)
  defaultDifficultyMix   Json? // { "LOW": 30, "MEDIUM": 50, "HIGH": 20 }
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt

  examType ExamType            @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  sections BaseConfigSection[]
  tests    Test[]

  @@index([examTypeId])
}

model BaseConfigSection {
  id               String   @id @default(cuid())
  baseConfigId     String
  name             String
  order            Int
  subjectId        String?
  questionCount    Int
  marksPerQuestion Decimal  @db.Decimal(6, 2)
  negativeMarks    Decimal  @db.Decimal(6, 2)
  durationSec      Int?
  mandatory        Boolean  @default(true)
  difficultyMix    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  baseConfig BaseConfig @relation(fields: [baseConfigId], references: [id], onDelete: Cascade)
  subject    Subject?   @relation(fields: [subjectId], references: [id])

  @@unique([baseConfigId, order])
  @@index([subjectId])
}

// ============================================================================
// Tests
// ============================================================================

model Test {
  id           String  @id @default(cuid())
  title        String
  examTypeId   String?
  baseConfigId String?

  status TestStatus @default(DRAFT)
  testUi TestUi     @default(CBT)

  totalQuestions         Int
  totalMarks             Decimal      @db.Decimal(8, 2)
  durationSec            Int
  sectionalTiming        Boolean      @default(false)
  lockedSectionSwitching Boolean      @default(false)
  optionalSectionCount   Int?
  calculatorEnabled      Boolean      @default(false)
  shuffleQuestions       Boolean      @default(true)
  shuffleOptions         Boolean      @default(true)
  languageMode           LanguageMode @default(SINGLE)
  languages              String[]     @default(["en"]) // ordered; DUAL shows all of them

  publishStartAt DateTime?
  publishEndAt   DateTime?
  entryCutoffSec Int?
  extraTimeSec   Int?

  isLocked    Boolean   @default(false) // true once first student starts
  finalizedAt DateTime?
  shareSlug   String?   @unique // shareable link token (optional)
  createdById String? // audit (Admin id)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime? // soft delete — see the conventions note above

  examType       ExamType?       @relation(fields: [examTypeId], references: [id])
  baseConfig     BaseConfig?     @relation(fields: [baseConfigId], references: [id])
  sections       TestSection[]
  paperQuestions PaperQuestion[]
  attempts       Attempt[]
  notifications  Notification[]

  series TestSeries[] // implicit M:N — access reaches students via series↔group

  @@index([status])
  @@index([publishStartAt, publishEndAt])
  @@index([examTypeId])
}

model TestSection {
  id               String   @id @default(cuid())
  testId           String
  name             String
  order            Int
  subjectId        String?
  questionCount    Int
  marksPerQuestion Decimal  @db.Decimal(6, 2)
  negativeMarks    Decimal  @db.Decimal(6, 2)
  durationSec      Int?
  mandatory        Boolean  @default(true)
  difficultyMix    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  subject        Subject?        @relation(fields: [subjectId], references: [id])
  paperQuestions PaperQuestion[]

  @@unique([testId, order])
  @@index([subjectId])
}

// The frozen paper: fixed set of questions for a test (same for everyone).
// Drawn once at finalize; per-student order/option shuffle from Attempt.shuffleSeed.
model PaperQuestion {
  id            String              @id @default(cuid())
  testId        String
  testSectionId String?
  questionId    String
  order         Int
  marks         Decimal             @db.Decimal(6, 2)
  negativeMarks Decimal             @db.Decimal(6, 2)
  status        PaperQuestionStatus @default(ACTIVE) // drop/bonus corrections
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt

  test     Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  section  TestSection?    @relation(fields: [testSectionId], references: [id])
  question Question        @relation(fields: [questionId], references: [id])
  answers  AttemptAnswer[]

  @@unique([testId, questionId])
  @@unique([testId, order])
  @@index([questionId]) // "which papers use this question" + analytics
  @@index([testSectionId])
}

// ============================================================================
// Attempts (holds live state AND the scored result — no separate Result table)
// ============================================================================

model Attempt {
  id        String        @id @default(cuid())
  testId    String
  studentId String
  status    AttemptStatus @default(IN_PROGRESS)

  // lifecycle
  startedAt    DateTime  @default(now())
  endsAt       DateTime // server-authoritative deadline
  submittedAt  DateTime?
  evaluatedAt  DateTime?
  shuffleSeed  Int
  resumeCount  Int       @default(0)
  locale       String    @default("en")
  sectionState Json? // per-section start/end/time-spent

  // scored (filled on evaluation)
  score            Decimal? @db.Decimal(8, 2)
  correctCount     Int?
  wrongCount       Int?
  unattemptedCount Int?
  sectionScores    Json?
  rank             Int? // last-computed snapshot; live value from Redis
  percentile       Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  test    Test            @relation(fields: [testId], references: [id])
  student Student         @relation(fields: [studentId], references: [id])
  answers AttemptAnswer[]

  @@unique([testId, studentId]) // one attempt per student (no retake)
  @@index([studentId]) // student's report dashboard: "my attempts"
  @@index([testId, status])
  @@index([testId, score])
}

// One row per question the student actually INTERACTED with (answered / marked /
// visited) — not one per paper question. Untouched questions have no row;
// "unattempted" is derived (paper size − rows) and its count is stored on Attempt.
// Composite PK (no surrogate id) keeps the highest-volume table lean.
model AttemptAnswer {
  attemptId        String
  paperQuestionId  String
  selectedOptionId String?
  state            AnswerState @default(NOT_VISITED)

  // analytics data points — captured from day one
  timeSpentSec   Int     @default(0)
  languageViewed String?

  // filled at scoring
  isCorrect    Boolean?
  marksAwarded Decimal?  @db.Decimal(6, 2)
  answeredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  attempt        Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  paperQuestion  PaperQuestion   @relation(fields: [paperQuestionId], references: [id])
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@id([attemptId, paperQuestionId])
  @@index([paperQuestionId]) // question-level analytics
}

// ============================================================================
// Branches — a fixed, slow-moving list only a super admin may add to.
//
// It exists because `Group.branch` was free text, and free text is how you end
// up with "Ameerpet", "ameerpet" and "Ameerpet " as three branches. An admin
// creating a group now PICKS a branch instead of assuming one.
//
// A branch is where a student attends and the catalog of exams offered there.
// Every online student sits in the one VIRTUAL branch, which has no address and
// is protected from rename, retirement and deletion.
// ============================================================================

model Branch {
  id        String     @id @default(cuid())
  /// UPPERCASE letters/digits, single-spaced — see the name rules in contracts.
  name      String     @unique
  type      BranchType @default(PHYSICAL)
  // Inactive is a write freeze: no new groups, students or series. Everything it
  // already holds keeps working.
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  deletedAt DateTime? // soft delete — see the conventions note above

  groups          Group[] // implicit M:N — the exams this branch offers
  baseStudents    Student[]          @relation("StudentBaseBranch")
  currentStudents Student[]          @relation("StudentCurrentBranch")
  testConfigs     BranchTestConfig[]
}

// What a branch offers its students, and when. Access is granted at SERIES
// level; the window here is the whole series' default. A per-test override is a
// future table, so adding one changes scheduling without touching access.
model BranchTestConfig {
  id           String    @id @default(cuid())
  branchId     String
  testSeriesId String
  enabled      Boolean   @default(false)
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  testSeries TestSeries @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)

  @@unique([branchId, testSeriesId])
  @@index([testSeriesId])
}

// ============================================================================
// Groups (batches) — the access unit. A group is linked to test series, and a
// student reaches those series' tests through it. Student -> Group ->
// TestSeries -> Test.
//
// HOW a group reaches a student depends on its `type`: GLOBAL is everybody with
// no rows stored at all, EXAM and PROGRAM match an entry in
// `Student.enrolledExams`, and SCHOLARSHIP and NON_IACE are handed out one
// student at a time through `Student.directGroupIds`.
//
// The name is unique per `examType`, not per branch: the same batch is taught at
// several centres, so branches are a catalog tag (M:N) rather than ownership.
// ============================================================================

model Group {
  id          String    @id @default(cuid())
  /// UPPERCASE letters/digits, single-spaced — see the name rules in contracts.
  name        String
  type        GroupType
  /// ExamType code — set for EXAM and PROGRAM, null for the rest.
  examType    String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime? // soft delete — see the conventions note above

  branches   Branch[] // implicit M:N — the centres offering this group
  testSeries TestSeries[] // implicit M:N — grants access to these series' tests

  @@unique([examType, name])
  @@index([type])
}

// ============================================================================
// Test series (many-to-many, optional, flat) — Test⇄Series is implicit
// ============================================================================

model TestSeries {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tests         Test[] // implicit M:N (a test can be in several series)
  groups        Group[] // implicit M:N — groups linked to this series get access
  branchConfigs BranchTestConfig[]
}

// ============================================================================
// Audit — data CRUD and imports only. An exam interaction is not an audit event;
// it is the attempt. Always-on and self-scoped: a super admin reads every row, a
// normal admin only their own.
// ============================================================================

// One row per import RUN — a sheet, a script sync, or a single-record add.
model ImportLog {
  id         String       @id @default(cuid())
  feature    AuditFeature
  source     ImportSource
  actorId    String?
  /// The uploaded sheet, or a snapshot of the payload a script sent.
  fileS3Key  String?
  total      Int          @default(0)
  created    Int          @default(0)
  updated    Int          @default(0)
  skipped    Int          @default(0)
  failed     Int          @default(0)
  status     String
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  errors     Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  rowActions RowActionLog[]

  @@index([feature, createdAt])
}

// One row per record changed. `changed` is { field: { from, to } } — the answer
// to "what actually changed", which a diff of two snapshots is not.
model RowActionLog {
  id          String         @id @default(cuid())
  feature     AuditFeature
  entityId    String
  action      AuditAction
  actorType   AuditActorType
  actorId     String?
  changed     Json?
  importLogId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  importLog ImportLog? @relation(fields: [importLogId], references: [id], onDelete: SetNull)

  @@index([feature, entityId, actorId, createdAt])
  @@index([importLogId])
}

// ============================================================================
// Notifications (in-app; e.g. "a test was assigned to your batch")
// ============================================================================

model Notification {
  id        String           @id @default(cuid())
  studentId String
  type      NotificationType
  title     String
  body      String?
  testId    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  deletedAt DateTime? // soft delete — see the conventions note above

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test    Test?   @relation(fields: [testId], references: [id], onDelete: SetNull)

  @@index([studentId, isRead])
}
