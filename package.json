{
  "name": "iace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:db": "node scripts/test-db.mjs",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "docs:check": "node scripts/check-docs.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:check": "node scripts/db-check.mjs",
    "db:seed": "prisma db execute --file prisma/seed.sql --schema prisma/schema.prisma && prisma db execute --file prisma/seed.catalog.sql --schema prisma/schema.prisma",
    "db:setup": "pnpm db:generate && pnpm db:migrate:deploy && pnpm db:seed",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "test:coverage": "node scripts/coverage.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@iace/config": "workspace:*",
    "@types/node": "22.20.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "shellcheck": "4.1.0",
    "sonarqube-scanner": "5.0.0",
    "syncpack": "15.3.3",
    "tsx": "4.23.12",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
