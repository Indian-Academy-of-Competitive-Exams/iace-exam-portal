#!/bin/sh
# Conventional commits. The history is a changelog and a bisect target, and
# both stop working the moment the subject line stops saying what changed.

export NVM_DIR="$HOME/.nvm"
# shellcheck source=/dev/null
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
pnpm exec commitlint --edit "$1"
