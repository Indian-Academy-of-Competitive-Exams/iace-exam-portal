# Installed on the STAGING box only; production deploys when somebody releases it (docs/04 §12).
[Unit]
Description=Bring the staging box to the latest release on every start
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/opt/examprep/deploy/boot-update.sh
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
