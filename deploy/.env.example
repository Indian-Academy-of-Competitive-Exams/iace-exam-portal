# Copy to deploy/.env on the API box and fill in. Compose reads it for substitution and the three
# API containers read it as their environment.
#
# EVERY KEY THE API READS IS HERE, under the same name as in ../.env.example, which explains each
# one; only what differs on a deployed box is explained again. `pnpm env:check` fails when the two
# templates, or a real file beside either, stop naming the same keys. What is NOT here is what a
# developer's machine alone sets: the Docker ports, the test and shadow databases, Sonar, the Vite
# URL, and API_PORT / API_ROLE / NODE_OPTIONS / UV_THREADPOOL_SIZE, which compose.yml sets per
# container.
#
# Generate each secret with:  openssl rand -base64 48
# Then: chmod 600, and push it to SSM as /examprep/<env>/env — that copy is what a replacement box
# pulls, and nothing reads it at runtime. deploy/README.md has both commands, docs/04 §11 the why.

# ---- The one hostname Caddy needs a certificate for ----
# The SPAs are on CloudFront, which brings its own; S3 presigned URLs are on an AWS name. So this
# is the only A record. Let's Encrypt REFUSES to issue for *.amazonaws.com, which is why an EC2
# public hostname cannot be used here — and the student app is a PWA, so it needs real HTTPS.
API_HOST=api.staging.examprep.iace.co.in
ACME_EMAIL=developer@iace.co.in

# ---- Per-container sizing. docs/04-infrastructure.md §3 and §13 carry the arithmetic. ----
# Staging (t4g.medium, one tester) is the default. Production (t4g.large) overrides the memory:
#   EXAM_MEM=2g  EXAM_HEAP_MB=1536 / CORE_MEM=1g  CORE_HEAP_MB=768 / WORKER_MEM=1g  WORKER_HEAP_MB=768
# The heap is MEGABYTES and roughly 80% of the container's memory: buffers, the Prisma engine and
# thread stacks live outside it. The API warns at boot in both directions if it is wrong.
#
# The shares are a RATIO, not a number of cores, and they bite only when the box is contended —
# raise one to make that service win a busy moment, never to give it more of an idle box. They need
# no change between staging and production, because the box size is not in them.
EXAM_CPU_SHARES=2048
EXAM_MEM=1g
EXAM_HEAP_MB=384
CORE_CPU_SHARES=1536
CORE_MEM=1g
CORE_HEAP_MB=384
WORKER_CPU_SHARES=1024
WORKER_MEM=1g
WORKER_HEAP_MB=384

# ---- Where this environment lives. The operator's reference; nothing in the repo reads these. ----
# The two instance ids are what `aws ssm start-session --target` takes, and the rest are the parts
# DATABASE_URL and REDIS_URL below are written from.
AWS_REGION=ap-south-1
BOX_A=i-0123456789abcdef0
BOX_B=i-0fedcba9876543210
DB_HOST=examprep-db.xxxx.ap-south-1.rds.amazonaws.com
DB_NAME=examprep_staging
DB_USER=examprep_staging
DB_PASSWORD=
VALKEY_HOST=10.0.1.20
VALKEY_PORT=6380
VALKEY_PASSWORD=

# ---- Mode ----
# Staging runs as development, NOT production, and deliberately: an admin signs in with an emailed
# OTP and a student with an SMS one, and the SMS aggregator is a DLT registration nobody has yet.
# In development OTP_SENDER=console returns the code as `devCode` on the request response, so a
# tester signs in with no provider. CORS_ORIGINS below is still enforced — corsOrigin uses the
# list whenever it is non-empty, whatever the mode.
#
# For production: NODE_ENV=production, OTP_SENDER=sms, plus SMS_PROVIDER_URL, SMS_PROVIDER_KEY,
# MAIL_USER and MAIL_PASSWORD. The API refuses to boot without them rather than failing at the
# first login, and refuses the dev_only_ secrets below outright.
NODE_ENV=development
OTP_SENDER=console

# ---- The browsers allowed to call the API: the two CloudFront distributions ----
CORS_ORIGINS=https://dxxxxxxxx.cloudfront.net,https://dyyyyyyyy.cloudfront.net

# Caddy is the only thing in front, and it is on this box, so there is one hop to trust.
TRUST_PROXY_HOPS=1

# ---- RDS. Shared instance, a database per environment. ----
# connection_limit is required in production and worth setting anyway: one container runs 20
# worker slots before it serves a request, and Prisma's default pool is five. On db.t4g.micro the
# instance ceiling is ~112 connections, so exam 8 + core 25 + worker 25 = 58 leaves room for
# staging's 10 and little else — a second exam container is what exhausts it, not traffic.
DATABASE_URL=postgresql://examprep_staging:PASSWORD@examprep-db.xxxx.ap-south-1.rds.amazonaws.com:5432/examprep_staging?schema=public&connection_limit=25&pool_timeout=20

# ---- Box B. The private address, the port for THIS environment, and its password. ----
#   production  :6379      staging  :6380
# The password is Box B's third lock, and it lives in deploy/valkey/.env on that box. The empty
# username before the colon is required — redis://:PASSWORD@host is the form ioredis reads.
REDIS_URL=redis://:PASSWORD@10.0.1.20:6380

# ---- Auth. Never the dev_only_ values from ../.env.example: production refuses them. ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- OTP policy ----
# The per-address and budget figures are what a load test from one machine meets first: raise them
# for the run and put them back after.
OTP_LENGTH=6
OTP_TTL_SEC=300
OTP_RESEND_COOLDOWN_SEC=45
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_PER_DAY=10
OTP_MAX_PER_DAY_PER_IP=3000
OTP_GLOBAL_DAILY_BUDGET_PAISE=300000
OTP_SIGNUP_DAILY_BUDGET_PAISE=50000

# ---- Rate limits, per minute ----
RATE_LIMIT_DEFAULT_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=120
RATE_LIMIT_OTP_REQUEST_PER_MIN=120
RATE_LIMIT_SITTING_PER_MIN=60

# ---- Request body limits ----
BODY_LIMIT_DEFAULT=256kb
BODY_LIMIT_IMPORT=10mb

# ---- Object storage. Real S3, signed by the instance role where one is attached. ----
# S3_ENDPOINT stays empty: it is only for MinIO locally. Leave the key pair empty on AWS too and
# attach an instance profile instead; the API refuses a half-pair.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=examprep-staging-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Where a browser READS a question image: unsigned, identical for every student, so the CDN
# caches one copy instead of fetching the same diagram from S3 per student. The CloudFront
# domain in front of the media bucket, whose questions/images prefix is publicly readable.
#
# NO BUCKET NAME IN THE PATH. The API joins this to the key as `${MEDIA_BASE_URL}/${key}`, and
# that distribution's origin IS the media bucket, so the key alone is the path. MinIO locally
# needs the bucket in it because MinIO is path-style; CloudFront is not.
MEDIA_BASE_URL=https://dmediaxxxx.cloudfront.net

# ---- SMS aggregator. Empty until a DLT registration exists; required once OTP_SENDER=sms. ----
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_OTP=
SMS_TEMPLATE_RESULT_READY=
SMS_TEMPLATE_TEST_ASSIGNED=
SMS_TEMPLATE_TEST_REMINDER=
SMS_TEMPLATE_ANNOUNCEMENT=

# ---- WhatsApp. Wired and off: an empty key leaves the channel unrouted. ----
WHATSAPP_INTERAKT_URL=https://api.interakt.ai/v1/public/message/
WHATSAPP_INTERAKT_API_KEY=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_RESULT_READY=
WHATSAPP_TEMPLATE_TEST_ASSIGNED=
WHATSAPP_TEMPLATE_TEST_REMINDER=
WHATSAPP_TEMPLATE_ANNOUNCEMENT=

# ---- What a paid notification costs, in PAISE ----
NOTIFICATION_COST_WHATSAPP_PAISE=17
NOTIFICATION_COST_SMS_PAISE=18
NOTIFICATION_MAX_RECIPIENTS=50000

# ---- Web push. One key pair per environment, generated once and kept; all three or none. ----
VAPID_SUBJECT=mailto:developer@iace.co.in
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Mobile push. Three fields of the Firebase service account; all three or none. ----
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Email (admin OTP; Gmail). Required once OTP_SENDER=sms. ----
MAIL_USER=
MAIL_PASSWORD=

# ---- Observability ----
# Empty means >=debug outside production and >=log in it.
LOG_LEVEL=
# A scraper identifies itself with this. REQUIRED in production, and alloy below sends it.
METRICS_TOKEN=

# ---- Log shipping. Grafana Cloud Loki, via the alloy container (deploy/alloy/config.alloy). ----
# ENVIRONMENT becomes the `env` label on every line, so one Loki holds both environments and a
# query can still tell them apart. It is NOT the API's NODE_ENV: staging runs as development.
ENVIRONMENT=staging
# All three from Grafana Cloud → your stack → Loki → "Send Logs". The password is an access
# policy token with `logs:write`, not your account password, and it is the one secret here that
# can be rotated without restarting the API.
LOKI_URL=https://logs-prod-012.grafana.net/loki/api/v1/push
LOKI_USERNAME=123456
LOKI_PASSWORD=

# Same stack, "Send Metrics" instead. A DIFFERENT username to the Loki one — Grafana Cloud numbers
# each signal separately — and the token needs `metrics:write`. Alloy scrapes /metrics off every
# exam, core and worker container it finds, using METRICS_TOKEN above, so nothing is listed twice.
PROM_URL=https://prometheus-prod-012.grafana.net/api/prom/push
PROM_USERNAME=654321
PROM_PASSWORD=
