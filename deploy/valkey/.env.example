# Copy to deploy/valkey/.env on Box B. Compose reads it from beside compose.yml with no flag.
#
# Generate each password with:  openssl rand -base64 36
# Then: chmod 600, and push the file to SSM as /iace/valkey/env (deploy/README.md).

# The VPC address of this box. Publishing to it rather than every interface is the second of the
# three locks — the security group is the first, the passwords below are the third.
PRIVATE_IP=10.0.1.20

# A password per process. The API carries its half in REDIS_URL as redis://:PASSWORD@host:port.
VALKEY_PROD_PASSWORD=
VALKEY_STAGING_PASSWORD=

# Per docs/04-infrastructure.md §7. Never leave either unset: Valkey grows until the kernel
# kills it, and an OOM-killed Valkey mid-event loses up to a second of answers.
PROD_MAXMEMORY=1200mb
STAGING_MAXMEMORY=256mb
