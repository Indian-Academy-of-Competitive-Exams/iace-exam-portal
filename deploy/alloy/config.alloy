// Box A's telemetry: every container's stdout into Loki, and the API's /metrics into Prometheus.
//
// Nothing in the API knows this exists. It reads what Docker already captured, which is why
// LOG_LEVEL in the API is still the only thing deciding how much there is to ship.
//
//   docker compose -f deploy/compose.yml --env-file deploy/.env up -d alloy
//
// The json-file caps in compose.yml stay as the local safety net: Alloy going down must cost
// visibility, never the disk.

discovery.docker "boxa" {
	host = "unix:///var/run/docker.sock"
}

// The compose SERVICE name, not the container name: `exam`, not `/iace-api-exam-1`.
discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service_name"
	}

	// Without this Alloy tails its own stdout, and one shipping error becomes a loop.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "alloy"
		action        = "drop"
	}
}

loki.source.docker "boxa" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.boxa.targets
	relabel_rules = discovery.relabel.containers.rules
	labels        = {env = sys.env("ENVIRONMENT")}
	forward_to    = [loki.process.levels.receiver]
}

// The API and Caddy both log one JSON object per line, and both call the severity `level`.
loki.process "levels" {
	stage.json {
		expressions = {level = ""}
	}

	// `level` and `service_name` only. A label is an index in Loki, so anything per-request or
	// per-bug belongs in the LINE and comes out at query time:
	//   {service_name="exam"} |= "bug=" | pattern "<_>bug=<bug> <_>" | sum by (bug)
	stage.labels {
		values = {level = ""}
	}

	forward_to = [loki.write.cloud.receiver]
}

loki.write "cloud" {
	endpoint {
		url = sys.env("LOKI_URL")

		basic_auth {
			username = sys.env("LOKI_USERNAME")
			password = sys.env("LOKI_PASSWORD")
		}
	}
}

// ---------------------------------------------------------------------------
// Metrics
// ---------------------------------------------------------------------------

// Discovered rather than listed, so `up -d --scale exam=4` is picked up with no edit here —
// the same reason Caddy's upstreams are `dynamic a`.
discovery.relabel "api" {
	targets = discovery.docker.boxa.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "exam|core|worker"
		action        = "keep"
	}

	// Built from the network address and the fixed port: nothing publishes 3000, so there is no
	// published port for discovery to have found.
	rule {
		source_labels = ["__meta_docker_network_ip"]
		regex         = "(.+)"
		replacement   = "$1:3000"
		target_label  = "__address__"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "role"
	}

	// The container, so four exam replicas are four series and not one that flaps between them.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "instance"
	}
}

prometheus.scrape "api" {
	targets = discovery.relabel.api.output
	// The same token the API checks; /metrics carries live attempt counts and error rates.
	bearer_token = sys.env("METRICS_TOKEN")
	// 15s is the default and what the histogram buckets assume; a slower scrape blurs a submit spike.
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.cloud.receiver]
}

prometheus.remote_write "cloud" {
	endpoint {
		url = sys.env("PROM_URL")

		basic_auth {
			username = sys.env("PROM_USERNAME")
			password = sys.env("PROM_PASSWORD")
		}
	}

	external_labels = {
		env = sys.env("ENVIRONMENT"),
	}
}
